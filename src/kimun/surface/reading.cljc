(ns kimun.surface.reading
  "Reading the sources by class (docs/v2/drafts/diseno-leer.md, cut 1). A declaration file
   registers readers with `(reading (files pattern) (fn [doc] …))`; here each reader is run,
   when asked and never when evaluating, on every project file its pattern reaches, and the
   propositions it emits are collected. Pure: it touches no disk and no git; the text of a file
   comes through the injected `read-now`.

   `doc` is the ONLY thing a reader sees of the file, plain data:
   `{:path \"desk/tasks/task-1.md\"
     :front {\"id\" \"task-1\" \"depends_on\" [\"task-0\"]}   ; the YAML frontmatter, string keys, or nil
     :sections [{:title \"Goal\" :level 2 :path [\"Task\" \"Goal\"] :text \"…\"}]
     :text \"the body, without the frontmatter\"}`
   - `:front` is the frontmatter as a map with string keys at every level, vectors for lists,
     and nothing but strings, numbers, booleans and nil as scalars: a YAML date or timestamp
     arrives as a string (`\"2026-11-15\"` when it is midnight UTC, else the ISO instant), never
     as a Java object. It is nil when the file has no frontmatter, when it does not parse as
     YAML, or when it parses to something that is not a map.
   - `:sections` are the ATX headings outside code, in order; `:path` is the titles of its
     ancestors and its own; `:text` is what lies between the heading and the NEXT heading of
     any level (its subsections are separate entries), without the heading, blank lines at both
     ends removed. The text before the first heading is in no section (it is in `:text`).
   - A file that is not Markdown (its name does not end in `.md` or `.markdown`) has
     `:front nil`, `:sections []` and `:text` its content as it is. Markdown has its CRLF read as LF.

   Files generated by `(generated …)` and the files under `kimun/` (the declarations) are never
   read, even if they match a pattern: what is generated is not a source.

   A proposition a reader emits is the one the evaluator makes (same `:id`: R, A, B, context)
   plus `:source {:path p}`; `combine` merges the ones of the same `:id`."
  (:require [clj-yaml.core :as yaml]
            [clojure.string :as str]
            [kimun.surface.declare :as declare]
            [kimun.surface.include :as include]
            [kimun.surface.markdown.cst :as cst]
            [kimun.surface.propositions :as props]))

;; --- doc -----------------------------------------------------------------------------------

(defn- markdown? [path] (boolean (re-find #"(?i)\.(md|markdown)$" (str path))))

(defn- plain
  "The YAML value `v` as plain data: string keys, vectors, and scalars that are strings, numbers,
   booleans or nil (dates and any other object become strings)."
  [v]
  (cond
    (nil? v) nil
    (map? v) (into {} (map (fn [[k x]] [(if (string? k) k (str (plain k))) (plain x)])) v)
    (or (sequential? v) (set? v)) (mapv plain v)
    (or (string? v) (boolean? v)) v
    (number? v) v
    #?@(:clj [(instance? java.util.Date v)
              (let [i (.toInstant ^java.util.Date v)
                    s (str i)]
                (if (str/ends-with? s "T00:00:00Z") (subs s 0 10) s))])
    (keyword? v) (name v)
    :else (str v)))

(defn- front-of
  "The frontmatter map of the frontmatter block `lines` (fences included), or nil."
  [lines]
  (let [yaml-text (str/join "\n" (butlast (rest lines)))
        data (try (yaml/parse-string yaml-text :keywords false)
                  (catch #?(:clj Exception :cljs :default) _ nil))]
    (when (map? data) (plain data))))

(defn- heading
  "`[level title]` of a heading block, or nil."
  [b]
  (when (= :heading (:kind b))
    (when-let [[_ hashes more] (re-matches #"^ {0,3}(#{1,6})(?: (.*)|)$" (cst/strip-cr (first (:lines b))))]
      [(count hashes) (-> (or more "") (str/replace #"(?<!\\)\s+#+\s*$" "") (str/replace #"^#+$" "") str/trim)])))

(defn- strip-blank-edges [s] (str/replace s #"^(\s*\n)+|(\n\s*)+$" ""))

(defn- sections-of
  "The sections of the body blocks `blocks` (see the namespace docstring)."
  [blocks]
  (loop [bs blocks, stack [], cur nil, out []]
    (let [flush (fn [out] (if cur (conj out (update cur :text #(strip-blank-edges (str/join "\n" %)))) out))]
      (if-let [b (first bs)]
        (if-let [[level title] (heading b)]
          (let [stack' (conj (vec (take-while #(< (:level %) level) stack)) {:level level :title title})]
            (recur (rest bs) stack'
                   {:title title :level level :path (mapv :title stack') :text []}
                   (flush out)))
          (recur (rest bs) stack (when cur (update cur :text into (map cst/strip-cr (:lines b)))) out))
        (flush out)))))

(defn doc-of
  "The `doc` (see the namespace docstring) of the file `path` whose content is `text`."
  [path text]
  (if-not (markdown? path)
    {:path path :front nil :sections [] :text text}
    (let [{:keys [blocks]} (cst/parse-document (str/replace text "\r\n" "\n"))
          fm? (= :frontmatter (:kind (first blocks)))
          body (if fm? (rest blocks) blocks)]
      {:path path
       :front (when fm? (front-of (:lines (first blocks))))
       :sections (sections-of body)
       :text (str/join "\n" (map cst/strip-cr (mapcat :lines body)))})))

;; --- running --------------------------------------------------------------------------------

(defn- clean [p] (str/replace (include/normalize-path p) #"^(\./)+" ""))

(defn- declared-type
  "The `:declare/*` ex-data along the cause chain of `e`, or nil."
  [e]
  (loop [x e]
    (cond (nil? x) nil
          (some-> (ex-data x) :type namespace (= "declare")) x
          :else (recur (ex-cause x)))))

(defn- error-row
  "`{:path :pattern :at :type :message}` for the reader `r` failing on `path` with `e`. When the
   failure knows the line of the form that failed (a declared error, or the position sci gives)
   the message starts with `declaration-file:line:`."
  [r path e timeout-ms]
  (let [d (declared-type e)
        line (or (:line (ex-data (or d e))) (:line (ex-data e)))
        msg (cond
              (and d (= :declare/timeout (:type (ex-data d)))) (str "the reader took more than " timeout-ms " ms on this file (an endless loop?); it was abandoned")
              d (ex-message d)
              :else (or (ex-message e) (str (class e))))]
    {:path path :pattern (:pattern r) :at (:at r)
     :type (if d (:type (ex-data d)) :declare/reading)
     :message (if (and line (not (str/starts-with? msg (str (:file (:at r)) ":"))) (not (some-> (ex-data d) :type (= :declare/timeout))))
                (str (:file (:at r)) ":" line ": " msg)
                msg)}))

(defn run
  "Runs the `readers` (`declare/readers`) over the project `paths` (relative to the root) and
   returns `{:emitted [p…] :errors [row…] :readings [row…]}`:
   - `:emitted`: every proposition emitted, in order of reader and then path, each with
     `:source {:path p}` (the same `:id` may repeat: `combine` merges them);
   - `:errors`: `[{:path :pattern :at :type :message}]`, one per (reader, file) that failed
     (it threw, took more than `timeout-ms`, emitted something invalid, or the file could not
     be read): that pair contributes nothing and the others go on;
   - `:readings`: per reader `{:pattern :at :context :matched n :propositions n :errors n}`.
   `opts`: `:read-now` `(fn [path] text-or-nil)`, `:timeout-ms` (default `declare/default-timeout-ms`)
   and `:exclude` (paths never read, e.g. the generated ones). Files under `kimun/` are never
   read. What a reader returns is ignored: only what it emits counts."
  [readers paths {:keys [read-now timeout-ms exclude] :or {timeout-ms declare/default-timeout-ms}}]
  (let [skip (into #{} (map clean) exclude)
        candidates (vec (remove #(or (contains? skip %) (str/starts-with? % "kimun/")) (map clean paths)))
        docs (atom {})
        doc-for (fn [path text] (or (get @docs path) (let [d (doc-of path text)] (swap! docs assoc path d) d)))
        results
        (vec (for [r readers
                   :let [matched (props/members (:pattern r) candidates)]]
               (let [per (for [path matched]
                           (let [text (read-now path)]
                             (if (nil? text)
                               {:error {:path path :pattern (:pattern r) :at (:at r) :type :declare/unreadable
                                        :message (str "the file could not be read: " path)}}
                               (try {:emitted (mapv #(assoc % :source {:path path})
                                                    (declare/collect (:file (:at r)) timeout-ms
                                                                     (let [d (doc-for path text)] (fn [] ((:fn r) d)))))}
                                    (catch #?(:clj Throwable :cljs :default) e
                                      {:error (error-row r path e timeout-ms)})))))]
                 {:reading (assoc (select-keys r [:pattern :at :context]) :matched (count matched)
                                  :propositions (reduce + (map #(count (:emitted %)) per))
                                  :errors (count (filter :error per)))
                  :emitted (vec (mapcat :emitted per))
                  :errors (vec (keep :error per))})))]
    {:emitted (vec (mapcat :emitted results))
     :errors (vec (mapcat :errors results))
     :readings (mapv :reading results)}))

(defn combine
  "The propositions `declared` (as the evaluator gives them) and the `emitted` ones of `run`
   merged by `:id`, in order: the declared ones first, then the new read ones. Of the same
   `:id` there is ONE proposition: it keeps the `:at` of the first one written (a declared one
   wins over a read one), the other positions go to `:also-at`, and every file it was read from
   is in `:sources [{:path p}…]` (distinct, in order; `:source` is the first of them). A
   proposition nobody read has neither key."
  [declared emitted]
  (let [step (fn [{:keys [out index]} p]
               (let [src (:source p)
                     extra-at (distinct (remove nil? (cons (:at p) (:also-at p))))]
                 (if-let [i (get index (:id p))]
                   {:out (update out i
                                 (fn [q]
                                   (let [srcs (let [s (or (:sources q) [])] (if (some #(= (:path src) (:path %)) s) s (conj s src)))
                                         known (set (cons (:at q) (:also-at q)))
                                         more (remove known extra-at)]
                                     (cond-> (assoc q :sources srcs :source (first srcs))
                                       (seq more) (update :also-at (fnil into []) more)))))
                    :index index}
                   {:out (conj out (-> p (dissoc :source) (assoc :source src :sources [src])))
                    :index (assoc index (:id p) (count out))})))
        start {:out (vec declared) :index (into {} (map-indexed (fn [i p] [(:id p) i])) declared)}]
    (:out (reduce step start emitted))))
