{:model/name "EdgeDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "source" :type :string :required true :description "Source node identifier." :py/annotation "<class 'str'>"} {:name "target" :type :string :required true :description "Target node identifier." :py/annotation "<class 'str'>"} {:name "condition_ref" :type :string :required false :description "Optional condition identifier guarding the transition." :py/annotation "<class 'str'>" :default ""}] :template "---\n# edge-xxx\nid: ⸢rev•id⸥\n# active | archived\nstatus: ⸢rev•status⸥\n# Source node identifier\nsource: ⸢rev•source⸥\n# Target node identifier\ntarget: ⸢rev•target⸥\n# Optional condition identifier guarding the transition\ncondition_ref: ⸢rev•condition_ref⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize the transition this edge represents._\n\n⸢rev•summary⸥" :py/references ["source" "target" "condition_ref"]}
