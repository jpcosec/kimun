{:model/name "BoardDoc" :model/version 1 :base ["OperationalArtifactDoc" "PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Board title for one active routing surface." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable board identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'system:sldb' or 'workspace:desk'." :py/annotation "list[str]" :default []} {:name "routine" :type :string :required false :description "Primary routine identifier that makes the artifact actionable." :py/annotation "<class 'str'>" :default ""} {:name "current_node" :type :string :required false :description "Current node in the operational routine or state machine." :py/annotation "<class 'str'>" :default ""} {:name "history" :type [:list :string] :required false :description "Operational transition history for the artifact." :py/annotation "list[str]" :default []} {:name "scope" :type :string :required true :description "What area or workspace this board routes." :py/annotation "<class 'str'>"} {:name "purpose" :type :string :required true :description "Why this board exists and what it indexes." :py/annotation "<class 'str'>"} {:name "tasks" :type [:list :string] :required false :description "Active task document references routed by this board." :py/annotation "list[str]" :default []} {:name "pills" :type [:list :string] :required false :description "Active pill document references routed by this board." :py/annotation "list[str]" :default []} {:name "rituals" :type [:list :string] :required false :description "Ritual document references relevant to this board." :py/annotation "list[str]" :default []} {:name "notes" :type :string :required false :description "Short operational notes about the current routed set." :py/annotation "<class 'str'>" :default "No additional notes."}] :template "---\n# board-xxx\nid: ⸢rev•id⸥\n# Affected workspace or domain\nscope: ⸢rev•scope⸥\n# List of task-xxx paths\ntasks: ⸢rev•tasks⸥\n# List of pill-xxx paths\npills: ⸢rev•pills⸥\n# List of ritual-xxx paths\nrituals: ⸢rev•rituals⸥\n# e.g., system:sldb, workspace:desk\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Purpose\n\n_Explain what this board routes and why it exists._\n\n⸢rev•purpose⸥\n\n## Notes\n\n_Add short operational notes about the current routed set._\n\n⸢rev•notes⸥\n\n## Task Details\n\n_Generated from the task references above._\n\n⸢render•task_summaries⸥" :py/containment {"tasks" ["TaskDoc"] "pills" ["PillDoc"] "rituals" ["RitualDoc"]} :py/compositions {"task_summaries" {"source_field" "tasks" "model" "deskops.models:TaskDoc" "template" "- {title} [{status}] - {goal}"}}}
