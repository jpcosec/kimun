{:model/name "ConditionDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "subject" :type :string :required true :description "Payload path the condition reads." :py/annotation "<class 'str'>"} {:name "predicate" :type :string :required true :description "Predicate applied to the subject value." :py/annotation "<class 'str'>"} {:name "expected" :type :string :required false :description "Expected value used by the predicate when needed." :py/annotation "<class 'str'>" :default ""}] :template "---\n# condition-xxx\nid: ⸢rev•id⸥\n# active | archived\nstatus: ⸢rev•status⸥\n# Payload path the condition reads\nsubject: ⸢rev•subject⸥\n# Predicate applied to the value (e.g., eq, contains)\npredicate: ⸢rev•predicate⸥\n# Expected value used by the predicate\nexpected: ⸢rev•expected⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize the predicate this condition checks._\n\n⸢rev•summary⸥"}
