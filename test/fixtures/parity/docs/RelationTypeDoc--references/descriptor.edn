{:model/name "RelationTypeDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Relation type title shown as the H1 heading." :py/annotation "<class 'str'>"} {:name "name" :type :string :required true :description "Vocabulary token for the relation type, e.g. booked_by or implements; the relation_type every edge carries." :py/annotation "<class 'str'>"} {:name "direction" :type [:enum "directed" "undirected"] :required false :description "Directed edges read source->target only; undirected edges are materialized in both directions." :py/annotation "typing.Literal['directed', 'undirected']" :default "directed"} {:name "cardinality" :type [:enum "one_to_one" "one_to_many" "many_to_one" "many_to_many"] :required false :description "How many targets one source may have and how many sources one target may have; validated at ingest." :py/annotation "typing.Literal['one_to_one', 'one_to_many', 'many_to_one', 'many_to_many']" :default "many_to_many"} {:name "axis" :type :string :required false :description "Predicate axis this relation answers (WHAT, WHY, HOW, WHERE, WHEN, PROVENANCE, ...); registered as an sldb predicate so prose links share the vocabulary." :py/annotation "<class 'str'>" :default ""} {:name "source_types" :type [:list :string] :required false :description "Node classes allowed as source: model names (with inheritance) or index node types; empty means any." :py/annotation "list[str]" :default []} {:name "target_types" :type [:list :string] :required false :description "Node classes allowed as target: model names (with inheritance) or index node types; empty means any." :py/annotation "list[str]" :default []} {:name "condition" :type :string :required false :description "sldb --where predicate every edge of this type inherits unless the RelationDoc overrides it; may name fields of the subject in braces, e.g. capacity >= {party_size}." :py/annotation "<class 'str'>" :default ""} {:name "description" :type :string :required true :description "Markdown section describing the meaning and intended use of the relation type; it is the verb's motive in a lexicon." :py/annotation "<class 'str'>"}] :template "---\nname: ⸢rev•name⸥\ndirection: ⸢rev•direction⸥\ncardinality: ⸢rev•cardinality⸥\naxis: ⸢rev•axis⸥\nsource_types: ⸢rev,list•source_types⸥\ntarget_types: ⸢rev,list•target_types⸥\ncondition: ⸢rev•condition⸥\n---\n\n# ⸢rev•title⸥\n\n## Description\n\n⸢rev,markdown•description⸥"}