{:model/name "DeskSpecDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Spec title shown as the H1 heading." :py/annotation "<class 'str'>"} {:name "product_goal" :type :string :required true :description "Markdown section stating the product or delivery goal." :py/annotation "<class 'str'>"} {:name "real_use_case" :type :string :required true :description "Markdown section describing the concrete use case." :py/annotation "<class 'str'>"} {:name "minimal_feature_slice" :type :string :required true :description "Markdown section defining the first credible delivery slice." :py/annotation "<class 'str'>"} {:name "current_missing" :type :string :required true :description "Markdown section listing what is still missing or blocking delivery." :py/annotation "<class 'str'>"} {:name "non_goals" :type :string :required true :description "Markdown section listing what is out of scope." :py/annotation "<class 'str'>"} {:name "acceptance_criteria" :type :string :required true :description "Markdown section listing what must be true for the slice to count as delivered." :py/annotation "<class 'str'>"}] :template "# ⸢rev•title⸥\n\n## Product Goal\n\n⸢rev,markdown•product_goal⸥\n\n## Real Use Case\n\n⸢rev,markdown•real_use_case⸥\n\n## Minimal Feature Slice To Deliver\n\n⸢rev,markdown•minimal_feature_slice⸥\n\n## What Is Currently Missing\n\n⸢rev,markdown•current_missing⸥\n\n## Non-Goals For This Delivery\n\n⸢rev,markdown•non_goals⸥\n\n## Acceptance Criteria\n\n⸢rev,markdown•acceptance_criteria⸥\n"}