{:model/name "AtomDoc" :model/version 1 :base [] :fields [{:name "id" :type :string :required true :description "Stable, unique atom identifier, conventionally 'atom-<slug>'." :py/annotation "<class 'str'>"} {:name "title" :type :string :required true :description "Short, descriptive title for the atomic knowledge unit." :py/annotation "<class 'str'>"} {:name "five_wh_one_plus" :type :yaml :required true :description "The single 5WH1+ question this atom answers: one of what, why, how, how_not, when, where, for_whom." :py/annotation "<enum 'AtomQuestion'>"} {:name "answer" :type :string :required true :description "The curated raw answer to the selected 5WH1+ question, written as one stable knowledge unit." :py/annotation "<class 'str'>"} {:name "tags" :type [:list :yaml] :required false :description "Namespaced semantic tags used for retrieval and grouping, each in the form namespace:value (e.g. system:deskops, topic:templates). Tags do not encode lifecycle, relations, evidence, or materialization." :py/annotation "list[typing.Annotated[str, FieldInfo(annotation=NoneType, required=True, description='Namespaced semantic tag in the form namespace:value.', metadata=[_PydanticGeneralMetadata(pattern='^[a-z][a-z0-9_]*:[a-z][a-z0-9_.-]*$')])]]" :default []} {:name "provenance" :type :string :required false :description "Optional URL or path to the authoritative source of this atom's knowledge. Used for traceability and provenance tracking." :py/annotation "str | None"}] :template "---\nid: ⸢rev•id⸥\ntitle: ⸢rev•title⸥\nfive_wh_one_plus: ⸢rev•five_wh_one_plus⸥\ntags: ⸢rev•tags⸥\nprovenance: ⸢optrev•provenance⸥\n---\n\n# ⸢render•title⸥\n\n## Answer\n\n⸢rev•answer⸥"}