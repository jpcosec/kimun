{:model/name "ChecklistDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "items" :type [:list :string] :required false :description "Human-readable checklist items." :py/annotation "list[str]" :default []} {:name "condition_refs" :type [:list :string] :required false :description "Condition identifiers that determine completion." :py/annotation "list[str]" :default []} {:name "mode" :type :string :required false :description "Checklist completion mode, such as all or any." :py/annotation "<class 'str'>" :default "all"}] :template "---\n# checklist-xxx\nid: ⸢rev•id⸥\n# draft | active | complete | archived\nstatus: ⸢rev•status⸥\n# List of condition-xxx paths\ncondition_refs: ⸢rev•condition_refs⸥\n# all | any\nmode: ⸢rev•mode⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize what this checklist proves._\n\n⸢rev•summary⸥\n\n## Items\n\n_List the human-readable checks in this checklist._\n\n- ⸢rev,list•items⸥" :py/containment {"condition_refs" ["ConditionDoc"]}}