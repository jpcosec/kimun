es, docs, commits, or commands." :py/annotation "list[str]" :default []} {:name "depends_on" :type [:list :string] :required false :description "Task identifiers that must complete first." :py/annotation "list[str]" :default []} {:name "pills" :type [:list :string] :required false :description "Pill identifiers required for safe execution of the task." :py/annotation "list[str]" :default []} {:name "files" :type [:list :string] :required false :description "Files or paths expected to change during the task." :py/annotation "list[str]" :default []} {:name "checklists" :type [:list :string] :required false :description "Checklist identifiers that verify the task's operational routine." :py/annotation "list[str]" :default []} {:name "implementation_path" :type :string :required true :description "Suggested implementation path for completing the task." :py/annotation "<class 'str'>"} {:name "validation" :type [:list :string] :required false :description "Tests, checks, or commands required before closure." :py/annotation "list[str]" :default []} {:name "done_when" :type :string :required true :description "Observable completion rule for the task." :py/annotation "<class 'str'>"} {:name "task_type" :type :string :required false :description "Workflow task type such as design, implementation, test, reflection, or closeout." :py/annotation "<class 'str'>" :default ""} {:name "inherits_from" :type [:list :string] :required false :description "Task identifiers that provide inherited workflow context." :py/annotation "list[str]" :default []} {:name "inherit_acceptance_context" :type :bool :required false :description "Whether validation and done-when context should be inherited from referenced tasks." :py/annotation "<class 'bool'>" :default false} {:name "atoms" :type [:list :string] :required false :description "Workflow or knowledge atoms explicitly bound to the task." :py/annotation "list[str]" :default []} {:name "from_drawer" :type :string :required false :description "