{:model/name "RelationDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Relation instance title shown as the H1 heading." :py/annotation "<class 'str'>"} {:name "source_id" :type :string :required true :description "Export id of the source document, Model:name (store:Model:name for a linked store)." :py/annotation "<class 'str'>"} {:name "target_id" :type :string :required true :description "Export id of the target document, Model:name (store:Model:name for a linked store)." :py/annotation "<class 'str'>"} {:name "relation_type" :type :string :required true :description "Vocabulary token naming the relation type; must match a tracked RelationTypeDoc name." :py/annotation "<class 'str'>"} {:name "condition" :type :string :required false :description "sldb --where predicate for this edge only; empty inherits the type's condition." :py/annotation "<class 'str'>" :default ""} {:name "notes" :type :string :required false :description "Optional markdown notes about this specific authored edge." :py/annotation "<class 'str'>" :default ""}] :template "---\nsource_id: ⸢rev•source_id⸥\ntarget_id: ⸢rev•target_id⸥\nrelation_type: ⸢rev•relation_type⸥\ncondition: ⸢rev•condition⸥\n---\n\n# ⸢rev•title⸥\n\n## Notes\n\n⸢rev,markdown•notes⸥" :py/references ["source_id" "target_id"]}
