{:model/name "AtomicDocumentDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Primary H1 heading for the atomic knowledge document." :py/annotation "<class 'str'>"} {:name "related_concepts" :type [:list :string] :required true :description "Short list of adjacent concepts that connect this atom to the wider SLDB knowledge graph." :py/annotation "list[str]"} {:name "what_it_is" :type :string :required true :description "Direct definition of the concept without workflow preamble or surrounding history." :py/annotation "<class 'str'>"} {:name "why_it_matters" :type :string :required true :description "Reason this concept exists and what user or system confusion it prevents." :py/annotation "<class 'str'>"} {:name "how_it_works" :type :string :required true :description "Operational explanation of the mechanism or contract that the concept represents." :py/annotation "<class 'str'>"} {:name "when_it_shows_up" :type :string :required true :description "Concrete moments in the SLDB workflow where a user or command encounters this concept." :py/annotation "<class 'str'>"} {:name "where_it_lives" :type :string :required true :description "Physical or logical location where the concept is materialized in files, commands, or runtime structures." :py/annotation "<class 'str'>"} {:name "who_uses_it" :type :string :required true :description "Primary consumers of the concept and the practical outcome they get from it." :py/annotation "<class 'str'>"}] :template "# ⸢rev•title⸥\n\n## Related Concepts\n\n- ⸢rev,list•related_concepts⸥\n\n## What It Is\n\n⸢rev•what_it_is⸥\n\n## Why It Matters\n\n⸢rev•why_it_matters⸥\n\n## How It Works\n\n⸢rev•how_it_works⸥\n\n## When It Shows Up\n\n⸢rev•when_it_shows_up⸥\n\n## Where It Lives\n\n⸢rev•where_it_lives⸥\n\n## Who Uses It\n\n⸢rev•who_uses_it⸥"}
