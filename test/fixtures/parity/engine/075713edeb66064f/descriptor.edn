{:model/name "RelationTypeDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Relation type title shown as the H1 heading." :py/annotation "<class 'str'>"} {:name "name" :type :string :required true :description "Vocabulary token for the relation type, e.g. flows_to or grounded_by." :py/annotation "<class 'str'>"} {:name "direction" :type [:enum "directed" "undirected"] :required true :description "Whether edges of this type are directed (source->target) or undirected." :py/annotation "typing.Literal['directed', 'undirected']"} {:name "cardinality" :type [:enum "one_to_one" "one_to_many" "many_to_many"] :required false :description "Allowed cardinality between source and target endpoints." :py/annotation "typing.Literal['one_to_one', 'one_to_many', 'many_to_many']" :default "many_to_many"} {:name "source_types" :type [:list :string] :required false :description "Allowed source node types; empty means any type is accepted." :py/annotation "list[str]" :default []} {:name "target_types" :type [:list :string] :required false :description "Allowed target node types; empty means any type is accepted." :py/annotation "list[str]" :default []} {:name "description" :type :string :required true :description "Markdown section describing the meaning and intended use of the relation type." :py/annotation "<class 'str'>"}] :template "---\nname: ⸢rev•name⸥\ndirection: ⸢rev•direction⸥\ncardinality: ⸢rev•cardinality⸥\nsource_types: ⸢rev,list•source_types⸥\ntarget_types: ⸢rev,list•target_types⸥\n---\n\n# ⸢rev•title⸥\n\n## Description\n\n⸢rev,markdown•description⸥\n"}
