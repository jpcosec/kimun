{:model/name "RelationDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Relation instance title shown as the H1 heading." :py/annotation "<class 'str'>"} {:name "source_id" :type :string :required true :description "Id of the source node this relation originates from." :py/annotation "<class 'str'>"} {:name "target_id" :type :string :required true :description "Id of the target node this relation points to." :py/annotation "<class 'str'>"} {:name "relation_type" :type :string :required true :description "Vocabulary token naming the relation type, matching a RelationTypeDoc name." :py/annotation "<class 'str'>"} {:name "notes" :type :string :required false :description "Optional markdown notes about this specific authored edge." :py/annotation "<class 'str'>" :default ""}] :template "---\nsource_id: ⸢rev•source_id⸥\ntarget_id: ⸢rev•target_id⸥\nrelation_type: ⸢rev•relation_type⸥\n---\n\n# ⸢rev•title⸥\n\n## Notes\n\n⸢rev,markdown•notes⸥\n"}
