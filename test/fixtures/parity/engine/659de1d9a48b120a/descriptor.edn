{:model/name "RoutineDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "entrypoint" :type :string :required true :description "Initial node identifier for the routine." :py/annotation "<class 'str'>"} {:name "decomposition" :type [:list :string] :required false :description "Ordered or grouped primitive identifiers participating in the routine." :py/annotation "list[str]" :default []} {:name "edges" :type [:list :string] :required false :description "Edge identifiers composing the routine graph." :py/annotation "list[str]" :default []} {:name "terminal_nodes" :type [:list :string] :required false :description "Node identifiers considered terminal for the routine." :py/annotation "list[str]" :default []}] :template "---\n# routine-xxx\nid: ⸢rev•id⸥\n# active | archived\nstatus: ⸢rev•status⸥\n# Initial node identifier\nentrypoint: ⸢rev•entrypoint⸥\n# Ordered or grouped primitive identifiers\ndecomposition: ⸢rev•decomposition⸥\n# Edge identifiers composing the graph\nedges: ⸢rev•edges⸥\n# Terminal node identifiers\nterminal_nodes: ⸢rev•terminal_nodes⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize what this routine does and how its nodes fit together._\n\n⸢rev•summary⸥" :py/references ["entrypoint" "terminal_nodes"] :py/containment {"decomposition" ["ChecklistDoc" "ConditionDoc" "OperatorDoc" "PrimitiveDoc" "StepDoc"] "edges" ["EdgeDoc"]}}
