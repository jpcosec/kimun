{:model/name "OperatorDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "action" :type :string :required true :description "Atomic runtime action, such as set_field or append_list." :py/annotation "<class 'str'>"} {:name "target" :type :string :required true :description "Payload path modified by the operator." :py/annotation "<class 'str'>"} {:name "value" :type :string :required false :description "Value used by the operator action." :py/annotation "<class 'str'>" :default ""}] :template "---\n# operator-xxx\nid: ⸢rev•id⸥\n# active | archived\nstatus: ⸢rev•status⸥\n# Atomic runtime action, e.g., set_field, append_list\naction: ⸢rev•action⸥\n# Payload path modified by the operator\ntarget: ⸢rev•target⸥\n# Value used by the operator action\nvalue: ⸢rev•value⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize the state transition this operator performs._\n\n⸢rev•summary⸥"}
