{:model/name "TaskDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Short action-oriented task title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable task identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required true :description "Current task state, typically active or blocked." :py/annotation "<class 'str'>"} {:name "goal" :type :string :required true :description "Concrete intended result for the task." :py/annotation "<class 'str'>"} {:name "scope" :type :string :required true :description "What is in and out of scope for the task." :py/annotation "<class 'str'>"} {:name "references" :type [:list :string] :required false :description "Relevant references such as files, docs, commits, or commands." :py/annotation "list[str]" :default []} {:name "depends_on" :type [:list :string] :required false :description "Task identifiers that must complete first." :py/annotation "list[str]" :default []} {:name "pills" :type [:list :string] :required false :description "Pill identifiers required for safe execution of the task." :py/annotation "list[str]" :default []} {:name "files" :type [:list :string] :required false :description "Files or paths expected to change during the task." :py/annotation "list[str]" :default []} {:name "implementation_path" :type :string :required true :description "Suggested implementation path for completing the task." :py/annotation "<class 'str'>"} {:name "validation" :type [:list :string] :required false :description "Tests, checks, or commands required before closure." :py/annotation "list[str]" :default []} {:name "done_when" :type :string :required true :description "Observable completion rule for the task." :py/annotation "<class 'str'>"} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'system:sldb' or 'language:python'." :py/annotation "l