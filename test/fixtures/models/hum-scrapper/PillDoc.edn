{:model/name "PillDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Pill title, including semantic prefix when useful, such as 'ADR:' or 'Pattern:'." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable pill identifier." :py/annotation "<class 'str'>"} {:name "what" :type :string :required true :description "What the pill defines or clarifies." :py/annotation "<class 'str'>"} {:name "why" :type :string :required true :description "Why this context matters for implementation or refactoring." :py/annotation "<class 'str'>"} {:name "when" :type :string :required true :description "When this pill should be applied." :py/annotation "<class 'str'>"} {:name "where" :type :string :required true :description "Where this pill applies, either as general scope or as references to existing code or docs." :py/annotation "<class 'str'>"} {:name "how" :type :string :required true :description "How to apply the guidance in practice." :py/annotation "<class 'str'>"} {:name "how_not" :type :string :required true :description "How not to apply the guidance or what to avoid." :py/annotation "<class 'str'>"} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'language:python' or 'library:pydantic'." :py/annotation "list[str]" :default []}] :template "# ⸢rev•title⸥\n\nID: ⸢rev•id⸥\n\n## What\n\n⸢rev•what⸥\n\n## Why\n\n⸢rev•why⸥\n\n## When\n\n⸢rev•when⸥\n\n## Where\n\n⸢rev•where⸥\n\n## How\n\n⸢rev•how⸥\n\n## How Not\n\n⸢rev•how_not⸥\n\n## Tags\n\n- ⸢rev,list•tags⸥"}
