{:model/name "AtomDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Short durable concept title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable atom identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required true :description "Atom lifecycle state, such as stable or incubating." :py/annotation "<class 'str'>"} {:name "category" :type :string :required true :description "Concept category used to group related atoms." :py/annotation "<class 'str'>"} {:name "what" :type :string :required true :description "Stable statement of what the concept is." :py/annotation "<class 'str'>"} {:name "why" :type :string :required true :description "Why the concept matters and what it protects or enables." :py/annotation "<class 'str'>"} {:name "how" :type :string :required true :description "How the concept should be applied or interpreted." :py/annotation "<class 'str'>"} {:name "when" :type :string :required true :description "When the concept becomes relevant in the workflow." :py/annotation "<class 'str'>"} {:name "where" :type :string :required true :description "Where the concept applies in code, docs, or operations." :py/annotation "<class 'str'>"} {:name "for_whom" :type :string :required true :description "Who should use or care about this concept." :py/annotation "<class 'str'>"} {:name "related_atoms" :type [:list :string] :required false :description "Related atom identifiers or references." :py/annotation "list[str]" :default []} {:name "materializes_into" :type [:list :string] :required false :description "Derived artifact references such as docs, features, tasks, or pills." :py/annotation "list[str]" :default []} {:name "stabilized_in" :type [:list :string] :required false :description "Durable artifacts where the atom has been stabilized or explained." :py/annotation "list[str]" :default []} {:name "distinct_from_pills" :type :string :required true :description "How this durable concept differs from temporary execution-time pills." :py/annotation "<class 'str'>"} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'topic:atoms' or 'system:sldb'." :py/annotation "list[str]" :default []}] :template "# ⸢rev•title⸥\n\nID: ⸢rev•id⸥\nStatus: ⸢rev•status⸥\nCategory: ⸢rev•category⸥\n\n## What\n\n⸢rev•what⸥\n\n## Why\n\n⸢rev•why⸥\n\n## How\n\n⸢rev•how⸥\n\n## When\n\n⸢rev•when⸥\n\n## Where\n\n⸢rev•where⸥\n\n## For Whom\n\n⸢rev•for_whom⸥\n\n## Related Atoms\n\n- ⸢rev,list•related_atoms⸥\n\n## Materializes Into\n\n- ⸢rev,list•materializes_into⸥\n\n## Stabilized In\n\n- ⸢rev,list•stabilized_in⸥\n\n## Distinct From\n\n⸢rev•distinct_from_pills⸥\n\n## Tags\n\n- ⸢rev,list•tags⸥"}
