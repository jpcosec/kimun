{:model/name "RoleDoc" :model/version 1 :base [] :fields [{:name "id" :type :string :required true :description "Stable role prompt identifier, conventionally 'role-<slug>'." :py/annotation "<class 'str'>"} {:name "name" :type :string :required true :description "Installed pi-agent role name, such as 'deskops-supervisor'." :py/annotation "<class 'str'>"} {:name "description" :type :string :required true :description "Short description of when to use this role prompt." :py/annotation "<class 'str'>"} {:name "kind" :type :string :required false :description "Agent runtime kind (e.g. pi, claude, opencode)." :py/annotation "<class 'str'>" :default "pi"} {:name "model" :type :string :required false :description "Primary model ID." :py/annotation "<class 'str'>" :default ""} {:name "fallback_models" :type [:list :string] :required false :description "Fallback models." :py/annotation "list[str]" :default []} {:name "tools" :type [:list :string] :required false :description "Enabled tools." :py/annotation "list[str]" :default []} {:name "system_prompt_mode" :type :string :required false :description "System prompt mode." :py/annotation "<class 'str'>" :default "replace"} {:name "inherit_project_context" :type :bool :required false :description "Inherit project context." :py/annotation "<class 'bool'>" :default true} {:name "inherit_skills" :type :bool :required false :description "Inherit project skills." :py/annotation "<class 'bool'>" :default true} {:name "default_context" :type :string :required false :description "Default context type (e.g. fork)." :py/annotation "<class 'str'>" :default "fresh"} {:name "body" :type :string :required true :description "Full role prompt markdown body after the YAML frontmatter." :py/annotation "<class 'str'>"}] :template "---\nid: ⸢rev•id⸥\nname: ⸢rev•name⸥\ndescription: ⸢rev•description⸥\nkind: ⸢rev•kind⸥\nmodel: ⸢rev•model⸥\nfallback_models: ⸢rev•fallback_models⸥\ntools: ⸢rev•tools⸥\nsystem_prompt_mode: ⸢rev•system_prompt_mode⸥\ninherit_project_context: ⸢rev•inherit_project_context⸥\ninherit_skills: ⸢rev•inherit_skills⸥\ndefault_context: ⸢rev•default_context⸥\n---\n\n⸢rev•body⸥"}
