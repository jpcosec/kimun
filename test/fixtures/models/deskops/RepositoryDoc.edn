{:model/name "RepositoryDoc" :model/version 1 :base [] :fields [{:name "name" :type :string :required true :description "Short human-readable name of the repository." :py/annotation "<class 'str'>"} {:name "id" :type :string :required false :description "Stable unique identifier for the repository." :py/annotation "typing.Optional[str]"} {:name "path" :type :string :required false :description "Relative path to the repository root from the ecosystem root." :py/annotation "typing.Optional[str]"} {:name "status" :type :string :required false :description "Current status of the repository (e.g., active, maintenance, archived)." :py/annotation "<class 'str'>" :default "active"} {:name "description" :type :string :required true :description "Markdown description of the repository's purpose and scope." :py/annotation "<class 'str'>"} {:name "tags" :type [:list :string] :required false :description "Semantic tags for categorization (e.g., type:tool, layer:infra)." :py/annotation "list[str]" :default []}] :template "---\n# repo-xxx\nid: ⸢rev•id⸥\n# Relative path to repository\npath: ⸢rev•path⸥\n# active | maintenance | archived\nstatus: ⸢rev•status⸥\n# e.g., type:tool, layer:infra\ntags: ⸢rev•tags⸥\n---\n\n# Repository: ⸢rev•name⸥\n\n## Description\n\n_Describe the repository purpose, scope, and role in the ecosystem._\n\n⸢rev,markdown•description⸥\n"}
