{:model/name "StepDoc" :model/version 1 :base [] :fields [{:name "title" :type :string :required true :description "Short step title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable step identifier." :py/annotation "<class 'str'>"} {:name "action" :type :string :required true :description "What the step should do." :py/annotation "<class 'str'>"} {:name "outcome" :type :string :required true :description "What the step should produce or confirm." :py/annotation "<class 'str'>"} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'topic:testing' or 'workspace:desk'." :py/annotation "list[str]" :default []}] :template "---\n# step-xxx\nid: ⸢rev•id⸥\n# e.g., topic:testing, workspace:desk\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Action\n\n_Describe the action this step performs._\n\n⸢rev•action⸥\n\n## Outcome\n\n_Describe the result or evidence this step should produce._\n\n⸢rev•outcome⸥"}
