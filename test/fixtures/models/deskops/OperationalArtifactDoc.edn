{:model/name "OperationalArtifactDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "routine" :type :string :required false :description "Primary routine identifier that makes the artifact actionable." :py/annotation "<class 'str'>" :default ""} {:name "current_node" :type :string :required false :description "Current node in the operational routine or state machine." :py/annotation "<class 'str'>" :default ""} {:name "history" :type [:list :string] :required false :description "Operational transition history for the artifact." :py/annotation "list[str]" :default []}] :template "---\n# primitive-xxx\nid: ⸢rev•id⸥\n# draft | active | archived\nstatus: ⸢rev•status⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n⸢rev•summary⸥"}
