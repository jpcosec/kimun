{:model/name "RunDoc" :model/version 1 :base [] :fields [{:name "id" :type :string :required true :description "Stable run identifier, conventionally 'run-<slug>'." :py/annotation "<class 'str'>"} {:name "title" :type :string :required true :description "Short human-readable label for the run." :py/annotation "<class 'str'>"} {:name "summary" :type :string :required true :description "Short summary of what this run attempted and its result." :py/annotation "<class 'str'>"} {:name "task_id" :type :string :required true :description "TaskDoc identifier this run executed against." :py/annotation "<class 'str'>"} {:name "role_id" :type :string :required true :description "RoleDoc identifier that was dispatched for this run." :py/annotation "<class 'str'>"} {:name "kind" :type :string :required true :description "Runtime binary identifier used for this run, matching RuntimeProfileDoc.kind." :py/annotation "<class 'str'>"} {:name "run_dir" :type :string :required true :description "Path to the run evidence directory under runs/subagents/, relative to the project root." :py/annotation "<class 'str'>"} {:name "herdr_pane_id" :type :string :required false :description "Herdr pane identifier the agent ran in; empty if not recorded or the pane no longer exists." :py/annotation "<class 'str'>" :default ""} {:name "session_path" :type :string :required false :description "Path to the session/transcript file produced by the runtime, relative to the project root." :py/annotation "<class 'str'>" :default ""} {:name "session_sha256" :type :string :required false :description "SHA-256 digest of the session file at the time it was last recorded, matching the closeout commit trailer." :py/annotation "<class 'str'>" :default ""} {:name "started_at" :type :string :required true :description "ISO 8601 timestamp when the run started." :py/annotation "<class 'str'>"} {:name "ended_at" :type :string :required false :description "ISO 8601 timestamp when the run ended; empty while the run is in progress." :py/annotation "<class 'str'>" :default ""} {:name "outcome" :type :string :required false :description "Run outcome: in_progress, success, failure, or aborted." :py/annotation "<class 'str'>" :default "in_progress"} {:name "commit_sha" :type :string :required false :description "Git commit hash of the closeout commit linked to this run; empty until closeout completes." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'system:deskops'." :py/annotation "list[str]" :default []}] :template "---\n# run-xxx\nid: ⸢rev•id⸥\n# Task identifier this run executed against\ntask_id: ⸢rev•task_id⸥\n# Role identifier dispatched for this run\nrole_id: ⸢rev•role_id⸥\n# Runtime binary identifier, matching RuntimeProfileDoc.kind\nkind: ⸢rev•kind⸥\n# Run evidence directory, relative to the project root\nrun_dir: ⸢rev•run_dir⸥\n# Herdr pane identifier, empty if not recorded\nherdr_pane_id: ⸢rev•herdr_pane_id⸥\n# Session/transcript file path, relative to the project root\nsession_path: ⸢rev•session_path⸥\n# SHA-256 digest of the session file\nsession_sha256: ⸢rev•session_sha256⸥\n# ISO 8601 start timestamp\nstarted_at: ⸢rev•started_at⸥\n# ISO 8601 end timestamp, empty while in progress\nended_at: ⸢rev•ended_at⸥\n# in_progress | success | failure | aborted\noutcome: ⸢rev•outcome⸥\n# Closeout commit hash, empty until closeout completes\ncommit_sha: ⸢rev•commit_sha⸥\n# e.g. system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize what this run attempted and its result._\n\n⸢rev•summary⸥" :py/references ["task_id" "role_id"]}
