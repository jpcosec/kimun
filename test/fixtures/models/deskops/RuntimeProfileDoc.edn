{:model/name "RuntimeProfileDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "kind" :type :string :required true :description "Runtime binary identifier this profile targets, matching RoleDoc.kind values (e.g. 'pi', 'claude', 'codex')." :py/annotation "<class 'str'>"} {:name "binary" :type :string :required true :description "Executable name or path Herdr invokes to start this runtime kind." :py/annotation "<class 'str'>"} {:name "model_flag" :type :string :required false :description "CLI flag used to pass the primary model id; empty means this runtime has no model flag." :py/annotation "<class 'str'>" :default ""} {:name "fallback_models_flag" :type :string :required false :description "CLI flag used to pass fallback model ids; empty means unsupported." :py/annotation "<class 'str'>" :default ""} {:name "fallback_models_join" :type :string :required false :description "How multiple fallback model values are combined for fallback_models_flag: 'comma', 'space', or 'repeat'." :py/annotation "<class 'str'>" :default "comma"} {:name "tools_flag" :type :string :required false :description "CLI flag used to pass the tool allowlist; empty means unsupported." :py/annotation "<class 'str'>" :default ""} {:name "tools_join" :type :string :required false :description "How multiple tool values are combined for tools_flag: 'comma', 'space', or 'repeat'." :py/annotation "<class 'str'>" :default "comma"} {:name "system_prompt_flag" :type :string :required false :description "CLI flag used to append or override the system prompt; empty means unsupported." :py/annotation "<class 'str'>" :default ""} {:name "system_prompt_delivery" :type :string :required false :description "How the system prompt text reaches the flag: 'inline' passes it directly as the flag value, 'file' writes it to a session-scoped file and passes the file path." :py/annotation "<class 'str'>" :default "inline"} {:name "session_flag" :type :string :required false :description "CLI flag used to pass the session/transcript file path; empty means this runtime has no resumable session concept." :py/annotation "<class 'str'>" :default ""} {:name "extra_args" :type [:list :string] :required false :description "Static CLI arguments always appended for this runtime, independent of role fields." :py/annotation "list[str]" :default []} {:name "unsupported_role_fields" :type [:list :string] :required false :description "RoleDoc field names this runtime cannot honor; used to warn instead of silently dropping role settings." :py/annotation "list[str]" :default []} {:name "notes" :type :string :required false :description "Operational notes such as authentication requirements or version pins for this runtime." :py/annotation "<class 'str'>" :default ""}] :template "---\n# runtime-xxx\nid: ⸢rev•id⸥\n# draft | active | archived\nstatus: ⸢rev•status⸥\n# Runtime binary identifier matching RoleDoc.kind values, e.g. pi, claude, codex\nkind: ⸢rev•kind⸥\nbinary: ⸢rev•binary⸥\n# Empty means this runtime does not support that capability\nmodel_flag: ⸢rev•model_flag⸥\nfallback_models_flag: ⸢rev•fallback_models_flag⸥\n# comma | space | repeat\nfallback_models_join: ⸢rev•fallback_models_join⸥\ntools_flag: ⸢rev•tools_flag⸥\n# comma | space | repeat\ntools_join: ⸢rev•tools_join⸥\nsystem_prompt_flag: ⸢rev•system_prompt_flag⸥\n# inline | file\nsystem_prompt_delivery: ⸢rev•system_prompt_delivery⸥\nsession_flag: ⸢rev•session_flag⸥\nextra_args: ⸢rev•extra_args⸥\n# RoleDoc fields this runtime cannot honor\nunsupported_role_fields: ⸢rev•unsupported_role_fields⸥\n# e.g. system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize what this runtime is and when to use it._\n\n⸢rev•summary⸥\n\n## Notes\n\n_Operational notes such as authentication requirements or version pins._\n\n⸢rev•notes⸥"}
