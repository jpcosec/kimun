{:model/name "HookDoc" :model/version 1 :base ["PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short primitive title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable primitive identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end using namespaced forms." :py/annotation "list[str]" :default []} {:name "event" :type :string :required true :description "Event name that can trigger the hook." :py/annotation "<class 'str'>"} {:name "target" :type :string :required true :description "Operator or routine identifier the hook targets." :py/annotation "<class 'str'>"} {:name "condition_ref" :type :string :required false :description "Optional condition identifier guarding the hook." :py/annotation "<class 'str'>" :default ""}] :template "---\n# hook-xxx\nid: ⸢rev•id⸥\n# active | archived\nstatus: ⸢rev•status⸥\n# Event name that can trigger the hook\nevent: ⸢rev•event⸥\n# Operator or routine identifier the hook targets\ntarget: ⸢rev•target⸥\n# Optional condition identifier guarding the hook\ncondition_ref: ⸢rev•condition_ref⸥\n# e.g., system:deskops\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Summary\n\n_Summarize when this hook fires and what it invokes._\n\n⸢rev•summary⸥" :py/references ["target" "condition_ref"]}
