{:model/name "RitualDoc" :model/version 1 :base ["OperationalArtifactDoc" "PrimitiveDoc"] :fields [{:name "title" :type :string :required true :description "Short ritual title." :py/annotation "<class 'str'>"} {:name "id" :type :string :required true :description "Stable ritual identifier." :py/annotation "<class 'str'>"} {:name "status" :type :string :required false :description "Primitive lifecycle status." :py/annotation "<class 'str'>" :default ""} {:name "summary" :type :string :required false :description "Short semantic summary for the primitive." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :string] :required false :description "Semantic tags placed at the end, using namespaced forms such as 'layer:workflow' or 'system:sldb'." :py/annotation "list[str]" :default []} {:name "routine" :type :string :required false :description "Primary routine identifier that makes the artifact actionable." :py/annotation "<class 'str'>" :default ""} {:name "current_node" :type :string :required false :description "Current node in the operational routine or state machine." :py/annotation "<class 'str'>" :default ""} {:name "history" :type [:list :string] :required false :description "Operational transition history for the artifact." :py/annotation "list[str]" :default []} {:name "purpose" :type :string :required true :description "Why the ritual exists." :py/annotation "<class 'str'>"} {:name "trigger" :type :string :required true :description "When the ritual should be started." :py/annotation "<class 'str'>"} {:name "preconditions" :type [:list :string] :required false :description "Conditions that must hold before running the ritual." :py/annotation "list[str]" :default []} {:name "steps" :type [:list :string] :required false :description "Ordered steps to execute as part of the ritual." :py/annotation "list[str]" :default []} {:name "validation" :type [:list :string] :required false :description "Checks that confirm the ritual was performed correctly." :py/annotation "list[str]" :default []} {:name "failure_modes" :type [:list :string] :required false :description "Common mistakes, drifts, or anti-patterns to avoid." :py/annotation "list[str]" :default []} {:name "completion" :type :string :required true :description "What indicates that the ritual has been completed." :py/annotation "<class 'str'>"}] :template "---\n# ritual-xxx\nid: ⸢rev•id⸥\n# List of step-xxx paths\nsteps: ⸢rev•steps⸥\n# e.g., layer:workflow, system:sldb\ntags: ⸢rev•tags⸥\n---\n\n# ⸢rev•title⸥\n\n## Purpose\n\n_Explain why this ritual exists._\n\n⸢rev•purpose⸥\n\n## Trigger\n\n_State when this ritual should start._\n\n⸢rev•trigger⸥\n\n## Preconditions\n\n_List the conditions that must hold before running the ritual._\n\n- ⸢rev,list•preconditions⸥\n\n## Validation\n\n_List the checks that prove the ritual was performed correctly._\n\n- ⸢rev,list•validation⸥\n\n## Failure Modes\n\n_List common mistakes this ritual prevents._\n\n- ⸢rev,list•failure_modes⸥\n\n## Completion\n\n_Describe what completion looks like._\n\n⸢rev•completion⸥\n\n## Step Details\n\n_Generated from the step references above._\n\n⸢render•step_details⸥" :py/containment {"steps" ["StepDoc"]} :py/compositions {"step_details" {"source_field" "steps" "model" "deskops.models:StepDoc" "template" "1. {title}: {action} -> {outcome}"}}}
