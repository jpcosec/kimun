{:model/name "CrossroadDoc" :model/version 1 :base [] :fields [{:name "id" :type :string :required true :description "Stable identifier: 'crossroad-' plus the path with dots written as '--'." :py/annotation "<class 'str'>"} {:name "path" :type :string :required true :description "Domain path this crossroad describes, e.g. pizzeria.carta." :py/annotation "<class 'str'>"} {:name "title" :type :string :required true :description "Short title of the domain area." :py/annotation "<class 'str'>"} {:name "content" :type :string :required true :description "Written description of what hangs below this path; must not be empty." :py/annotation "<class 'str'>"}] :template "---\nid: ⸢rev•id⸥\npath: ⸢rev•path⸥\ntitle: ⸢rev•title⸥\n---\n\n# ⸢render•title⸥\n\n## Content\n\n⸢rev,markdown•content⸥"}
