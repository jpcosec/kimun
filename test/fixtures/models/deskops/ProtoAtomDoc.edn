{:model/name "ProtoAtomDoc" :model/version 1 :base [] :fields [{:name "id" :type :string :required true :description "Stable, unique protoatom identifier, conventionally 'proto-<slug>'." :py/annotation "<class 'str'>"} {:name "title" :type :string :required true :description "Short title of the free knowledge unit." :py/annotation "<class 'str'>"} {:name "content" :type :string :required false :description "Free markdown content, with no fixed question or structure." :py/annotation "<class 'str'>" :default ""} {:name "tags" :type [:list :yaml] :required false :description "Namespaced tags; a single domain:<path> tag places the protoatom in the domain tree." :py/annotation "list[typing.Annotated[str, FieldInfo(annotation=NoneType, required=True, description='Namespaced semantic tag in the form namespace:value.', metadata=[_PydanticGeneralMetadata(pattern='^[a-z][a-z0-9_]*:[a-z][a-z0-9_.-]*$')])]]" :default []} {:name "typed_as" :type :string :required false :description "Model:id of the document this protoatom was typed into; when set, the protoatom is a redirect stub." :py/annotation "str | None"} {:name "provenance" :type :string :required false :description "Optional URL or path to the source of this knowledge." :py/annotation "str | None"}] :template "---\nid: ⸢rev•id⸥\ntitle: ⸢rev•title⸥\ntags: ⸢rev•tags⸥\ntyped_as: ⸢optrev•typed_as⸥\nprovenance: ⸢optrev•provenance⸥\n---\n\n# ⸢render•title⸥\n\n## Content\n\n⸢rev,markdown•content⸥"}
