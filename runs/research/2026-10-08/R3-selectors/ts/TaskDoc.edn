{:model "TaskDoc",
 :selector
 {:yaml
  {:carrier "frontmatter",
   :keys
   ["id"
    "status"
    "summary"
    "tags"
    "history"
    "references"
    "depends_on"
    "pills"
    "files"
    "checklists"]},
  :h1 "title",
  :sections
  {"Rationale"
   {:field "why",
    :body true,
    :ph
    "_Explain why this task exists or the business driver behind it._"},
   "Goal"
   {:field "goal",
    :body true,
    :ph "_Describe the concrete result this task must produce._"},
   "Scope"
   {:field "scope",
    :body true,
    :ph "_State what is in scope and what is out of scope._"},
   "Implementation Path"
   {:field "implementation_path",
    :body true,
    :ph
    "_Outline the expected implementation route or affected surface._"},
   "Validation"
   {:field "validation",
    :list true,
    :ph "_List the checks required before this task can close._"},
   "Done When"
   {:field "done_when",
    :body true,
    :to-end true,
    :ph
    "_Name the observable condition that makes the task complete._"}}},
 :queries
 [{:frontmatter "(minus_metadata) @fm"}
  {:h1 "((section (atx_heading (atx_h1_marker) (inline) @t)) @sec)"}
  {"why"
   "((section (atx_heading (inline) @title)) @sec (#match? @title \"Rationale\"))"}
  {"goal"
   "((section (atx_heading (inline) @title)) @sec (#match? @title \"Goal\"))"}
  {"scope"
   "((section (atx_heading (inline) @title)) @sec (#match? @title \"Scope\"))"}
  {"implementation_path"
   "((section (atx_heading (inline) @title)) @sec (#match? @title \"Implementation Path\"))"}
  {"validation"
   "((section (atx_heading (inline) @title) (list (list_item (paragraph (inline) @item)))) (#match? @title \"Validation\"))"}
  {"done_when"
   "((section (atx_heading (inline) @title)) @sec (#match? @title \"Done When\"))"}]}
