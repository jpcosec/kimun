{:model/name "RitualDoc",
 :model/version 1,
 :base ["OperationalArtifactDoc" "PrimitiveDoc"],
 :selector
 [{:outer-index 0,
   :outer-type "front_matter",
   :outer-tag "",
   :handler :yaml,
   :markers
   [{:key "id", :marker {:kind "rev", :traits [], :name "id"}}
    {:key "steps", :marker {:kind "rev", :traits [], :name "steps"}}
    {:key "tags", :marker {:kind "rev", :traits [], :name "tags"}}]}
  {:outer-index 1,
   :outer-type "heading",
   :outer-tag "h1",
   :handler :text,
   :props ["title"],
   :props-info [{:kind "rev", :traits [], :name "title"}],
   :regex "^(.*?)$"}
  {:outer-index 2,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QPurpose\\E$"}
  {:outer-index 3,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\Q_Explain why this ritual exists._\\E$"}
  {:outer-index 4,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["purpose"],
   :props-info [{:kind "rev", :traits [], :name "purpose"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 5,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QTrigger\\E$"}
  {:outer-index 6,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\Q_State when this ritual should start._\\E$"}
  {:outer-index 7,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["trigger"],
   :props-info [{:kind "rev", :traits [], :name "trigger"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 8,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QPreconditions\\E$"}
  {:outer-index 9,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_List the conditions that must hold before running the ritual._\\E$"}
  {:outer-index 10,
   :outer-type "bullet_list",
   :outer-tag "ul",
   :handler :list,
   :name "preconditions",
   :marker {:kind "rev", :traits ["list"], :name "preconditions"},
   :item-template "⸢rev,list•preconditions⸥"}
  {:outer-index 11,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QValidation\\E$"}
  {:outer-index 12,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_List the checks that prove the ritual was performed correctly._\\E$"}
  {:outer-index 13,
   :outer-type "bullet_list",
   :outer-tag "ul",
   :handler :list,
   :name "validation",
   :marker {:kind "rev", :traits ["list"], :name "validation"},
   :item-template "⸢rev,list•validation⸥"}
  {:outer-index 14,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QFailure Modes\\E$"}
  {:outer-index 15,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\Q_List common mistakes this ritual prevents._\\E$"}
  {:outer-index 16,
   :outer-type "bullet_list",
   :outer-tag "ul",
   :handler :list,
   :name "failure_modes",
   :marker {:kind "rev", :traits ["list"], :name "failure_modes"},
   :item-template "⸢rev,list•failure_modes⸥"}
  {:outer-index 17,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QCompletion\\E$"}
  {:outer-index 18,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\Q_Describe what completion looks like._\\E$"}
  {:outer-index 19,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["completion"],
   :props-info [{:kind "rev", :traits [], :name "completion"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 20,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QStep Details\\E$"}
  {:outer-index 21,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\Q_Generated from the step references above._\\E$"}
  {:outer-index 22,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props [],
   :props-info [],
   :regex "^.*?$",
   :anchor true}]}
