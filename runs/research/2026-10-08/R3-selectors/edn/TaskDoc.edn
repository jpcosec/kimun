{:model/name "TaskDoc",
 :model/version 1,
 :base ["OperationalArtifactDoc" "PrimitiveDoc"],
 :selector
 [{:outer-index 0,
   :outer-type "front_matter",
   :outer-tag "",
   :handler :yaml,
   :name "frontmatter",
   :marker {:kind "rev", :traits ["dict"], :name "frontmatter"}}
  {:outer-index 1,
   :outer-type "heading",
   :outer-tag "h1",
   :handler :text,
   :props ["title"],
   :props-info [{:kind "rev", :traits [], :name "title"}],
   :regex "^(.*?)$"}
  {:outer-index 2,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QRationale\\E$"}
  {:outer-index 3,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_Explain why this task exists or the business driver behind it._\\E$"}
  {:outer-index 4,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["why"],
   :props-info [{:kind "rev", :traits [], :name "why"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 5,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QGoal\\E$"}
  {:outer-index 6,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_Describe the concrete result this task must produce._\\E$"}
  {:outer-index 7,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["goal"],
   :props-info [{:kind "rev", :traits [], :name "goal"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 8,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QScope\\E$"}
  {:outer-index 9,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\Q_State what is in scope and what is out of scope._\\E$"}
  {:outer-index 10,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["scope"],
   :props-info [{:kind "rev", :traits [], :name "scope"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 11,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QImplementation Path\\E$"}
  {:outer-index 12,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_Outline the expected implementation route or affected surface._\\E$"}
  {:outer-index 13,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["implementation_path"],
   :props-info
   [{:kind "rev", :traits [], :name "implementation_path"}],
   :regex "^(.*?)$",
   :capture :section-body}
  {:outer-index 14,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QValidation\\E$"}
  {:outer-index 15,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_List the checks required before this task can close._\\E$"}
  {:outer-index 16,
   :outer-type "bullet_list",
   :outer-tag "ul",
   :handler :list,
   :name "validation",
   :marker {:kind "rev", :traits ["list"], :name "validation"},
   :item-template "⸢rev,list•validation⸥"}
  {:outer-index 17,
   :outer-type "heading",
   :outer-tag "h2",
   :handler :text,
   :anchor true,
   :props [],
   :regex "^\\QDone When\\E$"}
  {:outer-index 18,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :anchor true,
   :props [],
   :regex
   "^\\Q_Name the observable condition that makes the task complete._\\E$"}
  {:outer-index 19,
   :outer-type "paragraph",
   :outer-tag "p",
   :handler :text,
   :props ["done_when"],
   :props-info [{:kind "rev", :traits [], :name "done_when"}],
   :regex "^(.*?)$",
   :capture :section-body}]}
