+     (def ^:private hex-digits "0123456789abcdef")
+
+     (defn- hex->bytes
+       "The 32 bytes of a 64-character lower-case hex id, into `arr` at `off`."
+       [^String hex ^bytes arr off]
+       (dotimes [i 32]
+         (aset-byte arr (+ off i)
+                    (unchecked-byte (+ (* 16 (Character/digit (.charAt hex (* 2 i)) 16))
+                                       (Character/digit (.charAt hex (inc (* 2 i))) 16)))))
+       arr)
+
+     (defn- bytes->hex
+       "The 64-character lower-case hex id of bytes [off, off+32) of `arr`."
+       [^bytes arr off len]
+       (let [sb (StringBuilder. (* 2 len))]
+         (dotimes [i len]
+           (let [b (bit-and 0xff (aget arr (+ off i)))]
+             (.append sb (.charAt hex-digits (bit-shift-right b 4)))
+             (.append sb (.charAt hex-digits (bit-and b 0xf)))))
+         (str sb)))
+
+     (def pack-index-entry
+       "Bytes of one `.idx` entry: id (32 binary) + offset (8) + length (4)."
