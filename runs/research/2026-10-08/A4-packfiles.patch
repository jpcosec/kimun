+(defn- build-format-2!
+  "Like `build-format-1!` but into a fresh format-2 store (the engine of format
+   3 without the :names index): the source of the 2 -> 3 upgrade test."
+  [dir steps]
+  (let [b (fs/backend dir)]
+    (reduce (fn [s [n f]]
+              (:store (store/commit! b s (plan (:head s) n (if (even? n) "jp" "kimun/derive") (f s)))))
+            (store/init! b h caps {:format-version 2})
+            (map-indexed vector steps))))
