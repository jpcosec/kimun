+     (defn- write-idx! [p entries]
+       "Writes the `.idx` of a pack: `entries` [[id offset length] …] in pack order."
+       (let [buf (ByteBuffer/allocate (* pack-index-entry (count entries)))
+             arr (.array buf)]
+         (doseq [[id off len] entries]
+           (hex->bytes id arr (.position buf))
+           (.position buf (+ (.position buf) 32))
+           (.putLong buf (long off))
+           (.putInt buf (int len)))
+         (Files/write p (.array buf)
+                      (into-array StandardOpenOption [StandardOpenOption/CREATE StandardOpenOption/TRUNCATE_EXISTING StandardOpenOption/WRITE]))))
 
-(defrecord FsBackend [dir cache heads-memo wait?]
+     (defn- read-idx! [p]
+       "The index of a pack: {id [offset length]}. Reads 76 bytes per entry."
+       (let [arr (Files/readAllBytes p) buf (ByteBuffer/wrap arr) n (quot (alength arr) pack-index-entry)]
+         (loop [i 0 acc (transient {})]
+           (if (= i n)
+             (persistent! acc)
+             (let [base (* i pack-index-entry)
+                   id (bytes->hex arr base 32)
+                   off (.getLong buf (+ base 32))
+                   len (.getInt buf (+ base 40))]
+               (recur (inc i) (assoc! acc id [off len])))))))
+
+     (defn- pack-paths [dir name] [(pack-path dir (str name ".pack")) (pack-path dir (str name ".idx"))])
+
+     (defn- write-pack!
+       "Writes pack `name` and its index next to `dir`, both by temp file + atomic
+        move: a crash leaves the old pack, never a torn one. `records` is a lazy
+        seq of [id text] in the order they must be written (the callers pass them
+        sorted by id); each text is consumed and dropped one at a time, so the
+        whole pack is never in memory. Returns {:pack :packed :bytes}."
+       [dir name records]
+       (Files/createDirectories (path dir "packs") (make-array java.nio.file.attribute.FileAttribute 0))
+       (let [[pp ip] (pack-paths dir name)]
+         (with-open [ch (FileChannel/open (path dir "packs" (str name ".pack.tmp"))
+                                          (into-array StandardOpenOption [StandardOpenOption/CREATE StandardOpenOption/TRUNCATE_EXISTING StandardOpenOption/WRITE]))]
+           (loop [i 0 off 0 entries [] rs (seq records)]
+             (if (empty? rs)
+               (do (write-idx! (path dir "packs" (str name ".idx.tmp")) entries)
+                   (Files/move (path dir "packs" (str name ".pack.tmp")) pp (into-array java.nio.file.CopyOption [StandardCopyOption/ATOMIC_MOVE StandardCopyOption/REPLACE_EXISTING]))
+                   (Files/move (path dir "packs" (str name ".idx.tmp")) ip (into-array java.nio.file.CopyOption [StandardCopyOption/ATOMIC_MOVE StandardCopyOption/REPLACE_EXISTING]))
+                   {:pack name :packed i :bytes off})
+               (let [[id text] (first rs)
+                     bytes (.getBytes ^String (str text) StandardCharsets/UTF_8)]
+                 (let [cb (ByteBuffer/wrap bytes)]
+                   (loop [] (when (.hasRemaining cb) (.write ch cb))))
+                 (recur (inc i) (+ off (alength bytes))
+                        (conj entries [id off (alength bytes)]) (rest rs))))))))
+
+     (defn- read-packed [ch off len]
+       "Content bytes [off, off+len) of an open pack channel, as UTF-8 text."
+       (let [buf (ByteBuffer/allocate (int len))]
+         (loop [pos (long off)]
+           (when (.hasRemaining buf)
+             (let [n (.read ch buf pos)] (when (pos? n) (recur (+ pos n))))))
+         (String. (.array buf) StandardCharsets/UTF_8)))
+
+     (defn- pack-index
+       "{id [offset length]} of pack `nm`, cached in the backend instance: the
+        `.idx` is read once per backend."
+       [b nm]
+       (or (get @(:packs b) nm)
+           (let [idx (read-idx! (pack-path (:dir b) (str nm ".idx")))]
+             (swap! (:packs b) assoc nm idx) idx)))
+
+     (defn- pack-channel
+       "Read channel of pack `nm`, kept open for the life of the backend instance
+        (packs are append-only; `prune!` closes and drops the cached channel)."
+       [b nm]
+       (or (get @(:channels b) nm)
+           (let [ch (FileChannel/open (pack-path (:dir b) (str nm ".pack"))
+                                      (into-array StandardOpenOption [StandardOpenOption/READ]))]
+             (swap! (:channels b) assoc nm ch) ch)))
+
+     (defn- forget-pack! [b nm]
+       "Drops the cached index and channel of pack `nm`."
+       (when-let [ch (get @(:channels b) nm)] (err/rescue-any (fn [_] nil) (.close ch)))
+       (swap! (:channels b) dissoc nm)
+       (swap! (:packs b) dissoc nm))
+
+     (defn pack!
+       "Moves every loose object of backend `b` into a new pack `packs/<stamp>.pack`
+        plus its `.idx`, then deletes the loose files, under the store lock (no
+        commit runs meanwhile; objects written after the listing stay loose and
+        are `read-object`'s first choice). Returns {:packed n :pack name :bytes
+        n} or {:packed 0} when there is nothing loose. Content is written under
+        each object's own id; a crash leaves the old layout or a temp file, never
+        a half pack."
+       [b]
+       (with-store-lock (:dir b) true
+         (fn []
+           (let [ids (loose-ids (:dir b))]
+             (if (empty? ids)
+               {:packed 0}
+               (let [nm (str (System/currentTimeMillis) "-" (System/nanoTime))
+                     r (write-pack! (:dir b) nm
+                                    (map (fn [id] [id (read-text (path (:dir b) "objects" id))]) ids))]
+                 (doseq [id ids] (err/rescue-any (fn [_] nil) (Files/delete (path (:dir b) "objects" id))))
+                 r))))))
+
+     (defn prune!
+       "Removes every object of backend `b` whose id is in `garbage`: deletes the
+        loose files and rewrites each pack that holds one without them (by
+        writing the kept records into a fresh pack, then deleting the old pack
+        and its index). Under the store lock. Returns {:loose n :packs k
+        :packed n}. A pack with nothing to drop is left untouched; the caller
+        (kimun stores gc) decides the set, and must never include an id
+        reachable from a logged revision."
+       [b garbage]
+       (with-store-lock (:dir b) true
+         (fn []
+           (let [g (set garbage)
+                 loose (filter g (loose-ids (:dir b)))
+                 _ (doseq [id loose] (err/rescue-any (fn [_] nil) (Files/delete (path (:dir b) "objects" id))))
+                 packs (pack-names (:dir b))]
+             (loop [names packs removed 0 rewritten 0]
+               (if-let [nm (first names)]
+                 (let [idx (pack-index b nm)
+                       keep (remove (fn [[id _]] (contains? g id)) idx)]
+                   (if (= (count keep) (count idx))
+                     (recur (rest names) removed rewritten)
+                     (let [ch (pack-channel b nm)
+                           nm' (str nm "-gc")]
+                       (write-pack! (:dir b) nm'
+                                    (map (fn [[id [off len]]] [id (read-packed ch off len)]) keep))
+                       (forget-pack! b nm)
+                       (doseq [p (pack-paths (:dir b) nm)] (err/rescue-any (fn [_] nil) (Files/delete p)))
+                       (recur (rest names) (+ removed (- (count idx) (count keep))) (inc rewritten)))))
+                 {:loose (count loose) :packs rewritten :packed removed})))))))
+ )
