+           r (upgrade/upgrade! (fs/backend src-dir) (fs/backend dst-dir) h)
+           f3 (store/open (fs/backend dst-dir) h)]
+       (is (= 2 (:from-format r)))
+       (is (= 3 (:format-version (store/read-descriptor (fs/backend dst-dir)))))
+       (is (= (:trees f2) (into {} (:trees f3))) "head trees keep their descriptor and merkle root")
+       (is (= (:edges f2) (:edges f3)))
+       (is (nil? (:names (rev/revision f2 (:head f2)))) "a format-2 Revision has no :names")
+       (is (string? (:names (rev/revision f3 (:head f3)))) "the upgraded head Revision carries the :names index")
+       (is (= [tid] (rev/trees-named f3 "a")))
+       (is (= [tid2] (rev/trees-named f3 "b")))
+       (is (:ok? (:verify r)))
+       (is (:ok? (store/verify-full (fs/backend dst-dir) h)))
+       (testing "every node and edge object of the source is in the new store under the same id"
