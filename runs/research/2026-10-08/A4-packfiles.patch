+(defn pack
+  "`kimun stores pack`: moves every loose object of the store into a new
+   packfile `packs/<stamp>.pack` plus its index, then deletes the loose files
+   (docs/v2/10 §9). The store lock is taken for the whole pack: no commit runs
+   meanwhile, and objects written after the listing stay loose and keep winning
+   over the index on read. Packing is explicit (never part of a commit: a commit
+   stays O(plan), a pack reads every loose object). Ids, bytes and the
+   H(content)==id invariant are untouched. Data: `{:packed :pack :bytes
+   :objects}` (`:packed 0` when nothing was loose)."
+  [_args opts {:keys [env cwd]}]
+  (let [dir (cli-store/resolve-store opts env cwd)
+        _ (when (or (nil? dir) (not (cli-store/store? dir))) (cli-store/open! dir))
+        b (cli-store/backend dir)
+        objects (count (store/object-ids b))
+        r (fs-store/pack! b)]
+    (out/ok "stores pack" {:store (store-ref (store/read-descriptor b) (str dir))
+                            :revision (:head (store/read-heads b))
+                            :data (assoc r :objects objects)})))
+
+(defn gc
+  "`kimun stores gc [--apply]`: reports the objects reachable from no revision
+   of the log (`kimun.kernel.store/garbage`: the losers of the CAS race and the
+   mmap nodes of superseded heads roots); `--apply` removes them (`prune!`:
+   loose files deleted, packs rewritten without them). Never deletes anything
+   reachable from a logged revision. Nothing is written without `--apply`.
+   Data: `{:mode :objects :garbage :sample}` plus, when applied, `{:removed
+   {:loose :packs :packed}}`."
+  [_args opts {:keys [env cwd]}]
+  (let [{:keys [backend descriptor store path]} (cli-store/open! (cli-store/resolve-store opts env cwd))
+        ids (store/garbage backend store)
+        applied (boolean (:apply opts))
+        removed (when applied (fs-store/prune! backend ids))]
+    (out/ok "stores gc" {:store (store-ref descriptor path)
+                          :revision (:head store)
+                          :data (cond-> {:mode (if applied "apply" "dry-run")
+                                         :objects (count (store/object-ids backend))
+                                         :garbage (count ids)
+                                         :sample (vec (take 10 ids))}
+                                  removed (assoc :removed removed))})))
+
