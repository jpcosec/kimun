diff --git a/test/kimun/kernel/gc_test.cljc b/test/kimun/kernel/gc_test.cljc
new file mode 100644
index 00000000..25fd5de3
--- /dev/null
+++ b/test/kimun/kernel/gc_test.cljc
@@ -0,0 +1,154 @@
+(ns kimun.kernel.gc-test
+  "K5, second cut: `kimun.kernel.store/gc!` removes only loose objects that the
+   heads and the whole history do not reach, applies under the writer lock after
+   looking again, and refuses (touching nothing) when the store is not in a
+   state where an unreachable object is known to be garbage (docs/v2/10 §11.6)."
+  (:require [babashka.fs :as bfs]
+            [clojure.test :refer [deftest is testing]]
+            [kimun.host.default :as host]
+            [kimun.host.fs-store :as fs]
+            [kimun.kernel.node :as node]
+            [kimun.kernel.store :as store]
+            [kimun.test-util :as ktu])
+  (:import [java.security MessageDigest]))
+
+(def h host/host)
+(def TS "2026-08-29T12:00:00.000Z")
+
+(defn- tid [i] (format "01ARZ3NDEKTSV4RRFFQ69G%04d" i))
+(defn- path-of [i] (str "d" (mod i 3) "/f" i ".md"))
+
+(defn- register-ops [i v]
+  (let [root (node/make h :sign :block {:format :markdown :type :document :attrs {:n i}})
+        ext (node/make h :sign :external
+                       {:locator {:kind :file :path (path-of i)} :sample ""
+                        :fingerprint "sha-256:1111111111111111111111111111111111111111111111111111111111111111"})]
+    [{:op :add-node :node root}
+     {:op :register-tree
+      :tree {:kind :document :name (str "d" i) :class "C" :content-hash (str "content-" v) :cached? true
+             :root (:id root)}
+      :id (tid i) :root (:id root) :merkle-root (str "projection-" v)
+      :route {:path (path-of i) :fingerprint (str "sha-256:" v) :class "C"
+              :projection-hash (str "projection-" v) :content-hash (str "content-" v)}}
+     {:op :add-node :node ext}
+     {:op :add-edge :edge {:type :reference :from (:id root) :to (:id ext)
+                           :evidence {:ref-hash (:id ext) :actor "jp"}}}]))
+
+(defn- commit! [dir ops]
+  (let [b (fs/backend dir) s (store/open b h)]
+    (:store (store/commit! b s {:plan/version 1 :base (:head s) :actor "jp" :engines {} :timestamp TS :ops (vec ops)}))))
+
+(defn- history
+  "A store after `n` commits: three documents, then `n`-1 edits of the first."
+  [n]
+  (let [dir (str (ktu/temp-dir "kimun-gc-"))]
+    (store/init! (fs/backend dir) h {"jp" :all} {})
+    (commit! dir (mapcat #(register-ops % 0) (range 3)))
+    (doseq [k (range 1 n)] (commit! dir (register-ops 0 k)))
+    dir))
+
+(defn- gc [dir opts] (store/gc! (fs/backend dir) h (merge {:grace-ms 0} opts)))
+(defn- inventory [dir] (let [b (fs/backend dir)] (store/unreachable b (store/open b h))))
+(defn- ids [dir] (set (store/object-ids (fs/backend dir))))
+
+(defn- sha256 [f]
+  (apply str (map #(format "%02x" %) (.digest (MessageDigest/getInstance "SHA-256") (bfs/read-all-bytes f)))))
+
+(defn- digests
+  "sha256 of every file under `dir` (cache and lock included), by relative path."
+  [dir]
+  (into (sorted-map)
+        (map (fn [f] [(str (bfs/relativize dir f)) (sha256 f)]))
+        (filter bfs/regular-file? (bfs/glob dir "**" {:hidden true}))))
+
+(deftest a-dry-run-writes-nothing-and-says-what-it-would-remove
+  (let [dir (history 4)
+        cands (set (map :id (:candidates (inventory dir))))
+        before (digests dir)
+        r (gc dir {})]
+    (is (pos? (count cands)))
+    (is (false? (:applied? r)))
+    (is (= cands (set (map :id (:would-remove r)))))
+    (is (pos? (:would-free r)))
+    (is (nil? (:removed r)))
+    (is (= before (digests dir)) "sha-256 of every file of the store is identical")))
+
+(deftest applying-removes-exactly-the-candidates-and-keeps-every-revision
+  (let [dir (history 4)
+        before (ids dir)
+        cands (set (map :id (:candidates (inventory dir))))
+        olds (set (keep (fn [id] (let [o (store/load-object (fs/backend dir) id)]
+                                   (when (and (map? o) (= "content-0" (:content-hash o)) (:tree o)) id)))
+                        before))
+        r (gc dir {:apply? true})
+        b (fs/backend dir)
+        s (store/open b h)]
+    (is (seq olds) "the first version of the edited document is only in history")
+    (is (= cands (set (map :id (:removed r)))))
+    (is (= (:freed r) (reduce + (map :bytes (:removed r)))))
+    (is (= (apply disj before cands) (ids dir)) "exactly the candidates are gone")
+    (is (every? (ids dir) olds) "an object only an old revision reaches is not removed")
+    (is (true? (:ok? (store/verify b s))))
+    (is (true? (:ok? (store/verify-full (fs/backend dir) h))) "the whole log still replays")
+    (testing "every committed revision is still served"
+      (let [log (store/committed-log b)]
+        (is (= 4 (count log)))
+        (is (every? #(some? (store/load-object b (:revision %))) log))))
+    (is (zero? (count (:candidates (inventory dir)))))
+    (is (some? (:store (store/commit! (fs/backend dir) (store/open (fs/backend dir) h)
+                                      {:plan/version 1 :base (:head s) :actor "jp" :engines {} :timestamp TS
+                                       :ops (register-ops 1 "after")})))
+        "and the store takes a new write")))
+
+(deftest a-store-that-is-not-in-a-known-state-is-refused-and-left-alone
+  (testing "an unreachable object that does not hash to its name"
+    (let [dir (history 3)
+          victim (:id (first (:candidates (inventory dir))))
+          _ (spit (str (bfs/path dir "objects" victim)) "tampered")
+          before (digests dir)
+          e (try (gc dir {:apply? true}) (catch clojure.lang.ExceptionInfo e e))]
+      (is (= :store/gc-refused (:type (ex-data e))))
+      (is (= [:damaged] (map :reason (:reasons (ex-data e)))))
+      (is (= before (digests dir)))))
+  (testing "a log line the heads do not record"
+    (let [dir (history 2)
+          heads (slurp (str (bfs/path dir "heads.edn")))
+          _ (commit! dir (register-ops 0 "third"))
+          _ (spit (str (bfs/path dir "heads.edn")) heads)
+          before (digests dir)]
+      (doseq [apply? [true false]]
+        (let [e (try (gc dir {:apply? apply?}) (catch clojure.lang.ExceptionInfo e e))]
+          (is (= :store/gc-refused (:type (ex-data e))))
+          (is (= [:uncommitted-tail] (map :reason (:reasons (ex-data e)))))))
+      (is (= before (digests dir))))))
+
+(deftest unreachable-objects-inside-a-pack-are-left-and-reported
+  (let [dir (history 4)
+        n (count (:candidates (inventory dir)))
+        _ (fs/pack! (fs/backend dir) {:max-bytes 1000000})
+        twice (:id (first (:candidates (inventory dir))))
+        ;; an interrupted pack leaves the loose copy next to the packed one
+        _ (spit (str (bfs/path dir "objects" twice)) (store/read-object (fs/backend dir) twice))
+        before (digests dir)
+        r (gc dir {:apply? true})]
+    (is (pos? n))
+    (is (= n (:unreachable r)))
+    (is (= [] (:removed r)))
+    (is (= n (count (:packed-unreachable r))))
+    (is (every? :class (:packed-unreachable r)))
+    (is (contains? (set (map :id (:packed-unreachable r))) twice) "loose and packed counts as packed: its loose copy stays")
+    (is (= before (digests dir)) "no pack and no file was rewritten")
+    (is (true? (:ok? (store/verify-full (fs/backend dir) h))))))
+
+(deftest recent-objects-are-kept-and-a-second-collection-removes-nothing
+  (let [dir (history 4)
+        n (count (:candidates (inventory dir)))
+        kept (gc dir {:apply? true :grace-ms 3600000})
+        first-run (gc dir {:apply? true})
+        second-run (gc dir {:apply? true})]
+    (is (= [] (:removed kept)))
+    (is (= n (count (:kept-young kept))) "everything was written a moment ago: the grace keeps it")
+    (is (= n (count (:removed first-run))))
+    (is (= [] (:removed second-run)))
+    (is (= 0 (:unreachable second-run)))
+    (is (= 0 (:freed second-run)))))
