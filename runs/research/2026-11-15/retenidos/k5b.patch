+(defn- gc-refusals
+  "The reasons `gc!` must not remove anything given inventory `r` and the ids
+   `lost` of committed log revisions the heads do not reach."
+  [r lost]
+  (cond-> []
+    (not (:stable? r)) (conj {:reason :unstable :why "the heads moved while the inventory was taken"})
+    (:uncommitted-tail r) (conj {:reason :uncommitted-tail
+                                 :why "the log ends with a line the heads do not record: a writer is mid-commit or died; its objects are unreachable but may be about to be reached"})
+    (seq (:damaged r)) (conj {:reason :damaged :ids (mapv :id (:damaged r))
+                              :why "unreachable objects that do not hash to their name: their class cannot be trusted"})
+    (seq lost) (conj {:reason :log-revision-unreached :ids (vec lost)
+                      :why "a committed log line names a revision the heads do not reach: the history is not what the store believes"})))
+
+(defn- gc-pass
+  "One look at the store (what `gc!` repeats under the lock when it applies):
+   reopens, takes the inventory, refuses or classifies every candidate into
+   `:remove`, `:young` (modified less than `grace-ms` ago) and `:packed`
+   (inside a pack, or not loose: left alone)."
+  [b host grace-ms]
+  (let [s (open b host)
+        r (unreachable b s)
+        live (reachable s)
+        lost (remove #(or (nil? %) (contains? live %)) (map :revision (committed-log b)))
+        refusals (gc-refusals r lost)]
+    (when (seq refusals)
+      (fail "gc refused: the store is not in a state where an unreachable object is known to be garbage"
+            {:type :store/gc-refused :reasons refusals}))
+    (let [cs (mapv #(assoc % :info (loose-info b (:id %))) (:candidates r))
+          packed? (fn [c] (or (nil? (:info c)) (:packed? (:info c))))
+          young? (fn [c] (< (:age-ms (:info c)) grace-ms))
+          loose (remove packed? cs)]
+      {:inventory r
+       :packed (vec (filter packed? cs))
+       :young (vec (filter young? loose))
+       :remove (vec (remove young? loose))})))
+
+(defn gc!
+  "Explicit garbage collection of the loose objects the heads do not reach
+   (docs/v2/10 §11.3.1). `opts` `{:apply? bool :grace-ms n}`; without `:apply?`
+   it is a dry run: it writes nothing and takes no lock.
+
+   Removable: a CANDIDATE of `unreachable` (neither the head, nor any ancestor
+   of it, nor the maps they name reach it; a plan a committed log line names is
+   `:held`, never a candidate) that is a LOOSE file last modified at least
+   `:grace-ms` ago (default 3600000). It refuses, raising `:store/gc-refused`
+   with `:reasons`, when the inventory is not stable, the log has an
+   uncommitted tail, an unreachable object is damaged, or a committed log
+   revision is not reached. Applying takes the writer lock (`with-write-lock`)
+   and takes the inventory again INSIDE it, so what is removed is decided with
+   no commit in between. A writer stores its objects BEFORE it asks for the
+   lock, so the lock cannot protect them: only the grace period does.
+
+   Objects inside a pack are never removed (packs are not rewritten): they are
+   `:packed-unreachable`. The derived cache is not looked at.
+
+   Returns `{:applied? :stored :unreachable :held :kept-young [{:id :class
+   :bytes}] :packed-unreachable [{:id :class}]}` plus, when applying,
+   `:removed [{:id :class :bytes}]` and `:freed` (bytes), else
+   `:would-remove [...]` and `:would-free`."
+  [b host {:keys [apply? grace-ms] :or {grace-ms 3600000}}]
+  (let [pass (if apply?
+               (with-write-lock b
+                 (fn []
+                   (let [p (gc-pass b host grace-ms)]
+                     (assoc p :done (mapv (fn [c] {:id (:id c) :class (:class c)
+                                                   :bytes (or (delete-loose! b (:id c)) 0)})
+                                          (:remove p))))))
+               (gc-pass b host grace-ms))
+        sized (fn [c] {:id (:id c) :class (:class c) :bytes (get-in c [:info :bytes] 0)})
+        r (:inventory pass)
+        total (fn [xs] (reduce + 0 (map :bytes xs)))
+        would (mapv sized (:remove pass))]
+    (cond-> {:applied? (boolean apply?)
+             :stored (:stored r) :unreachable (:unreachable r) :held (count (:held r))
+             :kept-young (mapv sized (:young pass))
+             :packed-unreachable (mapv #(select-keys % [:id :class]) (:packed pass))}
+      apply? (assoc :removed (:done pass) :freed (total (:done pass)))
+      (not apply?) (assoc :would-remove would :would-free (total would)))))
+
