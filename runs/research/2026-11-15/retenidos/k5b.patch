@@ -0,0 +1,54 @@
+(ns kimun.cli.gc-test
+  "`kimun stores gc` end to end (K5, second cut): a dry run unless `--yes`,
+   and after `--yes` the store still checks and verifies and nothing loose is
+   left to collect."
+  (:require [babashka.fs :as fs]
+            [clojure.test :refer [deftest is]]
+            [kimun.cli.main :as main]
+            [kimun.surface.markdown.ast :as ast]
+            [kimun.test-util :as ktu]))
+
+(def env {"USER" "tester"})
+
+(defn- run [cwd & argv] (binding [ast/*parser* "native"] (:envelope (main/run argv env cwd))))
+(defn- data [cwd & argv] (:data (apply run cwd argv)))
+(defn- file [p & parts] (str (apply fs/path p parts)))
+
+(defn- project []
+  (let [p (str (ktu/temp-dir "kimun-cli-gc-"))]
+    (run p "stores" "init" "--name" "p")
+    (fs/create-dirs (file p "notes"))
+    (spit (file p "notes" "a.md") "# A\n\none\n")
+    (run p "docs" "ingest" "notes/a.md")
+    (doseq [text ["two" "three" "four"]]
+      (spit (file p "notes" "a.md") (str "# A\n\n" text "\n"))
+      (run p "docs" "update" "notes/a.md" "--name" "a"))
+    p))
+
+(defn- snapshot [dir]
+  (into (sorted-map) (map (fn [f] [(str (fs/relativize dir f)) (slurp (str f))]))
+        (filter fs/regular-file? (fs/glob dir "**" {:hidden true}))))
+
+(deftest gc-is-a-dry-run-until-yes-and-leaves-a-store-that-verifies
+  (let [p (project)
+        before (snapshot (file p ".kimun"))
+        n (get-in (data p "stores" "unreachable") [:candidates :count])
+        dry (run p "stores" "gc" "--grace" "0")
+        d (:data dry)]
+    (is (true? (:ok dry)) (pr-str dry))
+    (is (pos? n))
+    (is (false? (:applied? d)))
+    (is (= n (get-in d [:would-remove :count])))
+    (is (pos? (:would-free d)))
+    (is (= before (snapshot (file p ".kimun"))) "nothing was written")
+    (is (= before (do (run p "stores" "gc" "--yes" "--dry-run" "--grace" "0") (snapshot (file p ".kimun")))) "--dry-run wins over --yes")
+    (let [objects (:objects (data p "stores" "check"))
+          done (data p "stores" "gc" "--yes" "--grace" "0")]
+      (is (true? (:applied? done)))
+      (is (= n (get-in done [:removed :count])))
+      (is (= (:would-free d) (:freed done)))
+      (is (= (- objects n) (:objects (data p "stores" "check"))))
+      (is (true? (:ok (run p "stores" "verify"))))
+      (is (= 0 (get-in (data p "stores" "unreachable") [:candidates :count])))
+      (is (= 0 (get-in (data p "stores" "gc" "--yes" "--grace" "0") [:removed :count]))))
+    (is (= 6 (:exit (run p "stores" "gc" "--grace" "-1"))))))
