+(ns kimun.surface.models.generate
+  "Named generation projections of a model (docs/v2/16 §2.2, §4.2): the same
+   instance payload written as different outputs, one per projection id. A
+   projection only reads the payload; it never changes what was captured (its
+   `content-hash` is the same before and after). Supported projection keys:
+   `:format` (`:markdown`, `:edn`, `:json`) and `:fields`. Anything else the
+   spec does not define (`:mode`, `:sugar`, ...) raises
+   `:models/projection-unsupported` naming it: it is never guessed. Pure: no
+   store, no files; generated documents (role `:generated`, F10) are not written."
+  (:require [clojure.string :as str]
+            [kimun.kernel.err :as err]
+            [kimun.surface.docs :as docs]
+            [kimun.surface.models.render :as render]
+            [kimun.surface.models.subgraph :as sg]))
+
+(def ^:private supported-keys #{:format :fields})
+
+(defn available
+  "Sorted projection ids of model `nm` in `index` (own and inherited)."
+  [index nm]
+  (vec (sort (keys (sg/compose-projections index nm)))))
+
+(defn- unsupported!
+  "Raises `:models/projection-unsupported` for `k` of projection `pid`."
+  [pid k v]
+  (err/raise :models/projection-unsupported
+             (str "projection " pid ": " (pr-str k) " " (pr-str v)
+                  " is not defined by docs/v2/16 and is not implemented")
+             {:projection pid :key k :value v}))
+
+(defn- field-names
+  "Field names a projection writes: its `:fields`, else all composed fields."
+  [index nm proj]
+  (or (:fields proj) (mapv :name (sg/compose-fields index nm))))
+
+(defn- pick
+  "Ordered `[[name value] ...]` of `names` from `payload`; raises
+   `:models/projection-field-missing` for a name the payload lacks."
+  [pid names payload]
+  (mapv (fn [n]
+          (when-not (contains? payload n)
+            (err/raise :models/projection-field-missing
+                       (str "projection " pid ": field `" n "` is not in the payload")
+                       {:projection pid :field n :payload-fields (vec (sort (keys payload)))}))
+          [n (get payload n)])
+        names))
+
+(defn- md-value
+  "Markdown text of one field value: a string as is, a sequence as bullets."
+  [v]
+  (cond (string? v) v
+        (sequential? v) (str/join "\n" (map #(str "- " %) v))
+        :else (pr-str v)))
+
+(defn- write
+  "Text of `pairs` in `fmt`. Markdown: one `## name` block per field (the spec
+   does not fix the layout: team decision); EDN and JSON keep the field order."
+  [fmt pairs]
+  (case fmt
+    :markdown (str/join "\n\n" (map (fn [[n v]] (str "## " n "\n\n" (md-value v))) pairs))
+    :edn (pr-str (into (array-map) pairs))
+    :json (str "{" (str/join ", " (map (fn [[n v]] (str (docs/py-json n) ": " (docs/py-json v))) pairs)) "}")))
+
+(defn- project-spec16
+  "Output of projection `pid` of model `nm` in `index` over `payload`."
+  [index nm pid payload]
+  (let [projs (sg/compose-projections index nm)
+        proj (get projs pid)]
+    (when-not proj
+      (err/raise :models/projection-unknown
+                 (str "model " (pr-str nm) " has no projection " pid "; available: " (pr-str (available index nm)))
+                 {:model nm :projection pid :available (available index nm)}))
+    (doseq [[k v] proj :when (not (contains? supported-keys k))] (unsupported! pid k v))
+    (write (:format proj) (pick pid (field-names index nm proj) payload))))
+
+(defn project
+  "Text of `payload` (string-keyed) under projection `pid` of a model. With a
+   `descriptor` alone: a v1 descriptor (`:template`, no `:generation`) offers
+   only `:markdown/v1`, byte for byte `render/render` (docs/v2/16 §3.2); a spec
+   16 descriptor offers its own projections (no `:base` resolution). With an
+   `index` (`subgraph/index-models`) and a model name `nm`: the projections
+   inherited along `:base`, the subclass adding or overriding one by one."
+  ([descriptor pid payload]
+   (if (and (string? (:template descriptor)) (nil? (:generation descriptor)))
+     (if (= :markdown/v1 pid)
+       (render/render descriptor payload)
+       (err/raise :models/projection-unknown
+                  (str "model " (pr-str (:model/name descriptor)) " has no projection " pid "; available: [:markdown/v1]")
+                  {:model (:model/name descriptor) :projection pid :available [:markdown/v1]}))
+     (project (sg/index-models [descriptor]) (:model/name descriptor) pid payload)))
+  ([index nm pid payload]
+   (project-spec16 index nm pid payload)))
