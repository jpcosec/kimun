@@ -0,0 +1,82 @@
+(ns kimun.surface.models.generate-test
+  "Named generation projections (docs/v2/16 §2.2, §4.2)."
+  (:require [babashka.fs :as fs]
+            [clojure.edn :as edn]
+            [clojure.string :as str]
+            [clojure.test :refer [deftest is]]
+            [kimun.host.default :as host]
+            [kimun.surface.docs :as docs]
+            [kimun.surface.models.generate :as gen]
+            [kimun.surface.models.render :as render]
+            [kimun.surface.models.subgraph :as sg]))
+
+(def ^:private fixture-models
+  (:models (edn/read-string
+            (slurp (str (fs/path (System/getProperty "user.dir") "test" "fixtures" "models" "spec16_examples.edn"))))))
+
+(defn- with-default
+  "Fixture index where ChecklistDoc's `:markdown/default` has no `:mode`
+   (`:mode :sections` is undefined by the spec) and PrimitiveDoc adds `:edn/brief`."
+  []
+  (sg/index-models
+   (map (fn [d]
+          (case (:model/name d)
+            "ChecklistDoc" (assoc-in d [:generation :projections :markdown/default] {:format :markdown})
+            "PrimitiveDoc" (assoc-in d [:generation :projections :edn/brief]
+                                     {:format :edn :fields ["id" "title" "summary"]})
+            d))
+        fixture-models)))
+
+(def ^:private payload
+  {"id" "c1" "title" "Release" "summary" "All green." "items" ["tests" "docs"]})
+
+(defn- raised
+  "`[type message data]` of the ex-info `f` raises."
+  [f]
+  (try (f) nil (catch clojure.lang.ExceptionInfo e [(:type (ex-data e)) (ex-message e) (ex-data e)])))
+
+(deftest two-projections-two-texts-same-capture
+  (let [ix (with-default)
+        before (docs/content-hash host/host payload)
+        full (gen/project ix "ChecklistDoc" :markdown/default payload)
+        short (gen/project ix "ChecklistDoc" :summary/short payload)]
+    (is (not= full short))
+    (is (str/includes? full "- docs"))
+    (is (not (str/includes? short "docs")))
+    (is (= before (docs/content-hash host/host payload)))))
+
+(deftest edn-brief-has-only-its-fields
+  (let [out (gen/project (with-default) "PrimitiveDoc" :edn/brief (assoc payload "title" "T"))]
+    (is (= {"id" "c1" "title" "T" "summary" "All green."} (edn/read-string out)))))
+
+(deftest unknown-projection-names-the-available
+  (let [[t msg] (raised #(gen/project (with-default) "ChecklistDoc" :nope payload))]
+    (is (= :models/projection-unknown t))
+    (is (every? #(str/includes? msg %) [":markdown/default" ":summary/short" ":edn/brief"]))))
+
+(deftest v1-projection-is-render-byte-for-byte
+  (let [d {:model/name "T" :model/version 1
+           :fields [{:name "title" :type :string :required true :description "t"}]
+           :template "# ⸢rev•title⸥\n\nBody."}]
+    (is (= (render/render d {"title" "Hi"}) (gen/project d :markdown/v1 {"title" "Hi"})))
+    (is (= "# Hi\n\nBody." (gen/project d :markdown/v1 {"title" "Hi"})))))
+
+(deftest subclass-inherits-and-overrides-without-touching-the-base
+  (let [ix (sg/index-models
+            (concat fixture-models
+                    [(assoc (first (filter #(= "ResumenDoc" (:model/name %)) fixture-models))
+                            :model/name "ResumenCorto" :base ["ResumenDoc"]
+                            :generation {:projections {:summary/short {:format :edn :fields ["summary"]}}})]))
+        p {"id" "r" "title" "T" "summary" "S"}]
+    (is (= {"summary" "S"} (edn/read-string (gen/project ix "ResumenCorto" :summary/short p))))
+    (is (contains? (set (gen/available ix "ResumenCorto")) :markdown/default) "inherited")
+    (is (= [:markdown/default] (gen/available ix "ResumenDoc")) "base untouched")))
+
+(deftest missing-field-and-undefined-keys-fail-loudly
+  (let [ix (with-default)
+        [t _ d] (raised #(gen/project ix "ChecklistDoc" :summary/short (dissoc payload "summary")))
+        [t2 msg2] (raised #(gen/project (sg/index-models fixture-models) "PrimitiveDoc" :markdown/default payload))]
+    (is (= :models/projection-field-missing t))
+    (is (= "summary" (:field d)))
+    (is (= :models/projection-unsupported t2))
+    (is (str/includes? msg2 ":mode"))))
