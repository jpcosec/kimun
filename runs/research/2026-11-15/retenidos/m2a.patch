+ :base [],
+ :document-role :source,
+ :substrate {:parser :sldb-md/blocks, :compat :legacy-v1-template},
+ :anchoring
+ {:fields
+  [{:name "id",
+    :type :string,
+    :required true,
+    :description
+    "Stable, unique atom identifier, conventionally 'atom-<slug>'.",
+    :py/annotation "<class 'str'>"}
+   {:name "title",
+    :type :string,
+    :required true,
