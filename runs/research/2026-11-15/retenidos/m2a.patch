+   {:name "tags",
+    :type [:list :yaml],
+    :required false,
+    :description
+    "Namespaced semantic tags used for retrieval and grouping, each in the form namespace:value (e.g. system:deskops, topic:templates). Tags do not encode lifecycle, relations, evidence, or materialization.",
+    :py/annotation
+    "list[typing.Annotated[str, FieldInfo(annotation=NoneType, required=True, description='Namespaced semantic tag in the form namespace:value.', metadata=[_PydanticGeneralMetadata(pattern='^[a-z][a-z0-9_]*:[a-z][a-z0-9_.-]*$')])]]",
+    :default []}
+   {:name "provenance",
+    :type :string,
+    :required false,
+    :description
+    "Optional URL or path to the authoritative source of this atom's knowledge. Used for traceability and provenance tracking.",
