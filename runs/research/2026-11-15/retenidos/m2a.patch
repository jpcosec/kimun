--- /dev/null
+++ b/test/kimun/cli/desk_models_test.cljc
@@ -0,0 +1,132 @@
+(ns kimun.cli.desk-models-test
+  "M2a: the desk models as spec 16 anchoring descriptors (`desk/models/*.edn`,
+   derived from the frozen v1 descriptors with `template->spec16`, every one
+   `:compat :legacy-v1-template`) and the `kimun.include.edn` that declares
+   them. The corpus is the real `desk/` of the checkout, read only: every build
+   runs on a temporary git repository that holds a copy of it."
+  (:require [babashka.fs :as fs]
+            [babashka.process :as process]
+            [clojure.edn :as edn]
+            [clojure.string :as str]
+            [clojure.test :refer [deftest is testing]]
+            [kimun.cli.main :as main]
+            [kimun.surface.docs :as tdocs]
+            [kimun.surface.models.compile :as compile]
+            [kimun.surface.models.extract :as extract]
+            [kimun.surface.models.subgraph :as subgraph]
+            [kimun.test-util :as ktu]))
+
+(def ^:private declared-models #{"AtomDoc" "InboxNoteDoc" "RepositoryDoc"})
+(def ^:private globs {"AtomDoc" "desk/atoms" "InboxNoteDoc" "desk/inbox" "RepositoryDoc" "desk/registry"})
+
+(defn- read-edn [f] (edn/read-string (slurp (str f))))
+(defn- v1 [n] (read-edn (str "test/fixtures/models/deskops/" n ".edn")))
+(defn- shipped [] (into {} (for [f (fs/glob "desk/models" "*.edn")] (let [d (read-edn f)] [(:model/name d) d]))))
+(defn- md-files [dir] (sort (map str (fs/glob dir "**.md"))))
+
+(defn- git! [dir & args]
+  (let [r (apply process/shell {:out :string :err :string :continue true :dir (str dir)} "git" args)]
+    (when-not (zero? (:exit r)) (throw (ex-info (str "git failed: " (:err r)) {})))))
+
+(defn- project
+  "A temporary git repo with a copy of the desk, the include and the models, and
+   the store built by `include build`."
+  []
+  (let [d (ktu/temp-dir "kimun-m2a-")]
+    (fs/copy-tree "desk" (str (fs/path d "desk")))
+    (fs/copy "kimun.include.edn" (str (fs/path d "kimun.include.edn")))
+    (git! d "init" "-q")
+    (git! d "config" "user.email" "t@example.com")
+    (git! d "config" "user.name" "t")
+    (git! d "add" "-A")
+    (git! d "commit" "-qm" "desk")
+    d))
+
+(defn- run [d & argv] (:envelope (main/run (vec argv) {"USER" "tester"} (str d))))
+(defn- built [] (let [d (project)] [d (run d "include" "build")]))
+
+(deftest the-shipped-models-are-valid-legacy-spec16-and-listed
+  (let [m (shipped)]
+    (is (= declared-models (set (keys m))))
+    (doseq [[n d] m]
+      (is (some? (subgraph/validate! d)) n)
+      (is (= :source (:document-role d)) n)
+      (is (= :legacy-v1-template (get-in d [:substrate :compat])) (str n ": Q8 assumption, never :strict"))
+      (is (= (compile/template->spec16 (v1 n)) (select-keys d (keys (compile/template->spec16 (v1 n))))) (str n " is the derived view, not hand written"))
+      (is (not (contains? d :template)) (str n ": v1 xor spec 16)")))
+    (let [[d b] (built)]
+      (is (true? (:ok b)) (pr-str b))
+      (is (true? (:ok (run d "models" "check"))) (pr-str (run d "models" "check")))
+      (is (= declared-models (set (map :name (:data (run d "models" "list")))))
+          (pr-str (run d "models" "list"))))))
+
+(deftest every-declared-document-extracts-like-v1
+  (doseq [n (sort declared-models)
+          :let [d (get (shipped) n) files (md-files (globs n))]]
+    (is (seq files) n)
+    (doseq [f files :let [text (slurp f)]]
+      (is (= (extract/extract (v1 n) text) (tdocs/extract-under d [] text)) f))))
+
+(deftest only-models-that-extract-like-v1-are-declared
+  (testing "a derived child model composed with its bases does not extract like v1, so it is not shipped"
+    (let [bases (map (comp compile/template->spec16 v1) ["PrimitiveDoc" "OperationalArtifactDoc"])
+          task (compile/template->spec16 (v1 "TaskDoc"))
+          text (slurp "desk/tasks/task-layer-g.md")]
+      (is (not= (extract/extract (v1 "TaskDoc") text) (tdocs/extract-under task bases text)))))
+  (testing "the include declares exactly the three that do, with their globs and no :force"
+    (let [inc (read-edn "kimun.include.edn")]
+      (is (= ["desk/models/*.edn"] (:models inc)))
+      (is (= (into {} (map (fn [[m g]] [m (str g "/**/*.md")])) globs)
+             (into {} (map (juxt :model :glob)) (:documents inc))))
+      (is (nil? (:force inc))))))
+
+(deftest include-builds-and-checks-clean
+  (let [[d b] (built)]
+    (is (true? (:ok b)) (pr-str b))
+    (is (= 3 (get-in b [:data :models])))
+    (is (= (reduce + (map (comp count md-files) (vals globs))) (get-in b [:data :documents])))
+    (is (zero? (get-in b [:data :documents-failed] 0)))
+    (let [c (run d "include" "check")]
+      (is (true? (:ok c)) (pr-str c))
+      (is (every? zero? (vals (get-in c [:data :findings])))))
+    (testing "documents per model equal the files of its glob; Board.md is not tracked"
+      (let [docs (:data (run d "docs" "list"))]
+        (doseq [[m g] globs]
+          (is (= (count (md-files g)) (count (filter #(= m (:model %)) docs))) m))
+        (is (not-any? #(str/ends-with? (str (:path %)) "Board.md") docs))))))
+
+(deftest the-built-store-is-healthy-and-searchable
+  (let [[d b] (built)]
+    (is (true? (:ok b)) (pr-str b))
+    (is (true? (:ok (run d "stores" "health"))) (pr-str (run d "stores" "health")))
+    (is (true? (:ok (run d "stores" "check"))) (pr-str (run d "stores" "check")))
+    (let [name "atom-tree-as-index"
+          shown (:data (run d "docs" "show" name))
+          title (get-in shown [:payload "title"])]
+      (is (seq title))
+      (testing "find reaches an atom by a field of its payload"
+        (let [f (run d "find" title)]
+          (is (true? (:ok f)) (pr-str f))
+          (is (str/includes? (pr-str f) name)))))
+    (testing "an edit outside every anchored field keeps the content hash"
+      (let [name "repo-kimun"
+            before (:data (run d "docs" "show" name))
+            file (str (fs/path d "desk/registry/repo-kimun.md"))
+            text (slurp file)
+            edited (str/replace text "# Relative path to repository" "# Relative path to the repository")]
+        (is (not= text edited))
+        (spit file edited)
+        (let [u (run d "docs" "update" name)
+              after (:data (run d "docs" "show" name))]
+          (is (true? (:ok u)) (pr-str u))
+          (is (not= (:source-hash before) (:source-hash after)))
+          (is (= (:content-hash before) (:content-hash after))))))))
+
+(deftest generation-from-a-spec16-class-stays-rejected
+  (let [[d _] (built)]
+    (doseq [argv [["fields" "set" "atom-tree-as-index" "title" "\"X\""]
+                  ["docs" "create" "AtomDoc" "brand-new" "--set" "title=X"]]
+          :let [e (apply run d argv)]]
+      (is (false? (:ok e)) (pr-str argv))
+      (is (= :cli/usage (keyword (get-in e [:error :type]))) (pr-str e))
+      (is (str/includes? (get-in e [:error :message]) "spec 16") (pr-str e)))))
