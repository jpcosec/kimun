+    :outer-type "heading",
+    :outer-tag "h2",
+    :handler :text,
+    :anchor true,
+    :props [],
+    :regex "^\\QAnswer\\E$"}
+   {:outer-index 3,
+    :outer-type "paragraph",
+    :outer-tag "p",
+    :handler :text,
+    :props ["answer"],
+    :props-info [{:kind "rev", :traits [], :name "answer"}],
+    :regex "^(.*?)$",
+    :capture :section-body}]},
+ :generation
+ {:projections
