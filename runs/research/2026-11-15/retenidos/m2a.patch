+    :required true,
+    :description
+    "The single 5WH1+ question this atom answers: one of what, why, how, how_not, when, where, for_whom.",
+    :py/annotation "<enum 'AtomQuestion'>"}
+   {:name "answer",
+    :type :string,
+    :required true,
+    :description
+    "The curated raw answer to the selected 5WH1+ question, written as one stable knowledge unit.",
