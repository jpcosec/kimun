graph TD
    subgraph SLDBCLI ["sldb CLI"]
        CLIDispatcher["cli.dispatcher"]
        subgraph CLIParsers ["cli.parsers.*"]
            ParsersCore["parsers.core"]
            ParsersModels["parsers.models"]
            ParsersDocs["parsers.docs"]
            ParsersFind["parsers.find"]
        end
        subgraph CLICommands ["cli.commands.*"]
            DirectCommands["basic / init / help / faq"]
            StoreCommands["store / model / doc / inbox"]
            QueryCommands["find / sections / fields / explore"]
        end
        subgraph CLIGraphOps ["cli.graph_ops.*"]
            GraphBuildAST["graph_ops.build_ast"]
            GraphBuildIR["graph_ops.build_ir"]
            GraphIterRecords["graph_ops.iter_records"]
        end
    end
    StoreFacade["store.facade"]
    subgraph CoreRuntime ["Core Runtime"]
        ASTPackage["core.ast.*"]
        ContractsPackage["core.contracts.*"]
        IRPackage["core.ir.*"]
        DataExtractor["core.data_extractor"]
        TemplateExtractor["core.template_extractor"]
        Renderer["core.renderer"]
    end
    subgraph Handlers ["core.handlers.*"]
        TextHandler["handlers.text"]
        ListHandler["handlers.list"]
        TableHandler["handlers.table"]
        YamlHandler["handlers.yaml"]
    end
    RendererEngines["core.renderer_engine.*"]
    ExceptionsPackage["core.exceptions.*"]
    ModelContract["models.structured_doc"]
    ValidationRuntime["runtime.validation"]
    subgraph StoreSubsystem ["Store Subsystem"]
        StoreModels["store.models.*"]
        subgraph StoreIO ["store.io.*"]
            IODocuments["io.documents_index"]
            IOModels["io.models_index"]
            IOLock["io.lock"]
            IOStoreIndex["io.store_index"]
            IOSemanticDAG["io.semantic_dag"]
        end
        StoreHashing["store.hashing"]
        StoreOps["store.ops"]
        StoreDiagnostics["store.diagnostics"]
        StoreResolver["store.resolver"]
        StoreSemantic["store.semantic"]
        StoreExport["store.export"]
        StoreMigration["store.migration"]
    end
    subgraph QueryEngine ["Query Engine"]
        QEStructural["query_engine.structural"]
        QESemantic["query_engine.semantic"]
        QEGlobalSemantic["query_engine.global_semantic"]
        QEFilter["query_engine.filter"]
    end
    subgraph LinksPackage ["links.*"]
        LinkParser["links.parser"]
        LinkResolver["links.resolver"]
        LinkComposer["links.composer"]
        LinkRecovery["links.recovery"]
    end
    subgraph Filesystem ["Filesystem"]
        MarkdownDocs["Markdown docs"]
        StoreFiles[".sldb YAML indexes"]
    end
    CLICommands -->|domain operations| StoreFacade
    StoreFacade -->|store operations| StoreSubsystem
    CLICommands -->|roundtrip/extract/render| ValidationRuntime
    ValidationRuntime -->|parse and render| CoreRuntime
    CoreRuntime -->|node handling| Handlers
    Renderer -->|format output| RendererEngines
    CLIGraphOps -->|AST + IR| CoreRuntime
    CLIGraphOps -->|search records| QueryEngine
    QueryEngine -->|load indexes| StoreIO
    StoreDiagnostics -->|hash verification| ValidationRuntime
    StoreHashing -->|field hashing| ValidationRuntime
    StoreSubsystem -->|YAML indexes| StoreFiles
    SLDBCLI -->|documents| MarkdownDocs
    LinksPackage -->|resolve links| StoreIO
    StoreExport -->|rebuild + export| StoreSemantic
    CLICommands -->|recover/compose| LinksPackage