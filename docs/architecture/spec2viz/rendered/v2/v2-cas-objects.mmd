graph TD
    subgraph Store ["Store (objects/#lt;id#gt; CAS + cache/ derived, formats 2/3/4)"]
        Revision["Revision {:trees :edges :incidence :parents :tx :actor :engines :timestamp} · id = H(8 fields)"]
        Mmap["mmap node {:mmap :leaf|:branch …} — history-independent Merkle map (:trees :edges :incidence roots)"]
        Descriptor["descriptor {:tree ULID :kind :name :root} (+ :class :content-hash, format 4)"]
        TreeObject["tree object {:node :children [[child tree-hash] …]} (sibling order in hash); format 4: in cache/ for a document with file"]
        Node["Node {:class :kind :content} · S sign / M symbol / G fact"]
        Edge["Edge {:type :from :to [:tree :order] :evidence} · no timestamp; format 4 removes :field-hashes"]
        ResolvedPlan["resolved plan (tx id = H(plan)) — the log line names it (format 3/4)"]
    end
    Heads["heads.edn {:head rev-id :heads-root mmap-root-id} (nominal refs, CAS)"]
    Log["log.edn — one Transaction per line: {:id :plan :revision} (format 2) | {:id :revision} (formats 3/4)"]
    Cache["cache/objects/#lt;id#gt; + cache/docs/#lt;key#gt;.edn (format 4, derived, gitignored): tree objects and block/text/opaque nodes"]
    Heads -->|"points to :head"| Revision
    Heads -->|":heads-root (tree-id → rev-id)"| Mmap
    Revision -->|"parents"| Revision
    Revision -->|":trees / :edges / :incidence roots"| Mmap
    Revision -->|"tx"| ResolvedPlan
    Mmap -->|"tree-id → [descriptor-id merkle-root]"| Descriptor
    Descriptor -->|"root (merkle-root)"| TreeObject
    TreeObject -->|"children (ordered)"| TreeObject
    TreeObject -->|"node"| Node
    Mmap -->|":edges (edge-id → true)"| Edge
    Mmap -->|":incidence (node-id → edges)"| Node
    Edge -->|"from / to / evidence.context"| Node
    Log -->|"replays into / names"| ResolvedPlan
    Cache -->|"holds derivable copies (format 4)"| TreeObject