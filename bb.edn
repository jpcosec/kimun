{:paths ["src" "resources" "test"]
 :min-bb-version "1.3.0"
 :tasks
 {:requires ([clojure.test :as t]
             [babashka.fs :as fs]
             [clojure.string :as str])
  cli {:doc "Run the kimun CLI in-process: bb cli stores check --format text"
       :task (let [p (apply shell {:continue true} "bb" "-m" "kimun.cli.main" *command-line-args*)]
               (System/exit (:exit p)))}
  desk {:doc "Build this repo's desk store (.kimun) from kimun.include.edn (thin alias of `kimun include build`); --rebuild moves an existing store aside."
        :task (let [p (apply shell {:continue true} "bb" "-m" "kimun.cli.main" "include" "build" *command-line-args*)]
                (System/exit (:exit p)))}
  jar {:doc "Build target/kimun.jar with the built-in `bb uberjar` (src + resources, main kimun.cli.main); stamps resources/git-sha. Named `jar` on purpose: a task named `uberjar` would shadow the built-in it calls and recurse."
       :task (let [sha (-> (shell {:out :string :continue true} "git" "rev-parse" "--short" "HEAD") :out str/trim)]
                   (spit "resources/git-sha" (str (if (str/blank? sha) "dev" sha) "\n"))
                   (fs/create-dirs "target")
                   (shell "bb" "--classpath" "src:resources" "uberjar" "target/kimun.jar" "-m" "kimun.cli.main")
                   (println "built target/kimun.jar" (if (str/blank? sha) "(git sha: dev)" (str "(git sha: " sha ")"))))}
  release {:doc "Build distributable bundles: bb release --platforms linux-amd64 [--local-bb] (scripts/release.clj)."
           :task (let [p (apply shell {:continue true} "bb" "scripts/release.clj" *command-line-args*)]
                   (System/exit (:exit p)))}
  lint {:doc "Dependency rings + docstrings (docs/v2/03 §1, §3): scripts/check_rings.clj."
        :task (shell "bb" "scripts/check_rings.clj")}
  oracle {:doc "Independent Python re-implementation of canonical-bytes checks the frozen node ids (docs/v2/tests/promises.md)."
          :task (shell "python3" "scripts/canon_oracle.py")}
  store-size {:doc "Object bytes by class, log and total of a store (docs/v2/14 §10; scripts/store_size.clj)."
              :task (let [p (apply shell {:continue true} "bb" "scripts/store_size.clj" *command-line-args*)]
                      (System/exit (:exit p)))}
  test {:doc "Run the kernel test suite on Babashka (clojure.test + test.check) after lint. Times every namespace, prints the slowest, and exits 1 on any failure."
        :depends [lint]
        :task (let [root (str (fs/create-temp-dir {:prefix (str "kimun-test-" (System/currentTimeMillis) "-" (System/nanoTime) "-")}))
                    ;; every test temporary lands inside this run's root (kimun.test-util),
                    ;; so a run deletes only its own and parallel runs never collide
                    _ (System/setProperty "kimun.test.tmp" root)
                    ->ns (fn [p]
                           (-> (str (fs/relativize "test" p))
                               (str/replace (re-pattern "\\.cljc$") "")
                               (str/replace "_" "-")
                               (str/replace fs/file-separator ".")
                               symbol))
                    nses (sort (map ->ns (fs/glob "test" "**/*_test.cljc")))]
                (if (empty? nses)
                  (println "no test namespaces under test/ yet")
                  (try
                    (doseq [n nses] (require n))
                    (let [results (mapv (fn [n]
                                            (let [t0 (System/currentTimeMillis)
                                                  r (try (t/run-tests n)
                                                         (catch Throwable _ {:test 1 :pass 0 :fail 0 :error 1}))]
                                              (assoc r :ns n :ms (- (System/currentTimeMillis) t0))))
                                          nses)
                            fail (reduce + (map :fail results))
                            error (reduce + (map :error results))
                            pass (reduce + (map :pass results))
                            tests (reduce + (map :test results))
                            ms (reduce + (map :ms results))]
                        (println (str "\nRan " (count nses) " namespaces in " (quot ms 1000) " s"))
                        (doseq [r (take 12 (sort-by :ms > results))]
                          (println (format "  %7d ms  %s" (:ms r) (:ns r))))
                        (println {:test tests :pass pass :fail fail :error error :namespaces (count nses)})
                        (when (pos? (+ fail error)) (System/exit 1)))
                      (finally (fs/delete-tree root)))))}}}
